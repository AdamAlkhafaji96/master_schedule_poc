{"number": 92, "name": "سُورَةُ اللَّيۡلِ", "englishName": "Al-Lail", "englishNameTranslation": "The Night", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ", "taj": "وَ[h:9999[ٱ]لَّيْلِ إِذَا يَغْشَىٰ"}, {"n": 2, "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ", "taj": "وَ[h:9999[ٱ][l[ل][g[نّ]َهَارِ إِذَا تَجَلَّىٰ"}, {"n": 3, "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "taj": "وَمَا خَلَقَ [h:14531[ٱ][l[ل]ذَّكَرَ وَ[h:929[ٱ]لْأُ[f:929[نث]َىٰٓ"}, {"n": 4, "text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ", "taj": "إِ[g[نّ]َ سَعْيَكُمْ لَشَتَّىٰ"}, {"n": 5, "text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ", "taj": "فَأَ[g[مّ]َا مَنْ أَعْطَىٰ وَ[h:2036[ٱ]تَّقَىٰ"}, {"n": 6, "text": "وَصَدَّقَ بِٱلْحُسْنَىٰ", "taj": "وَصَدَّقَ بِ[h:13002[ٱ]لْحُسْنَىٰ"}, {"n": 7, "text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ", "taj": "فَسَنُيَسِّرُهُ[n[ۥ] لِلْيُسْرَىٰ"}, {"n": 8, "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ", "taj": "وَأَ[g[مّ]َا م[i:14532[َنۢ ب]َخِلَ وَ[h:13634[ٱ]سْتَغْنَىٰ"}, {"n": 9, "text": "وَكَذَّبَ بِٱلْحُسْنَىٰ", "taj": "وَكَذَّبَ بِ[h:13002[ٱ]لْحُسْنَىٰ"}, {"n": 10, "text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ", "taj": "فَسَنُيَسِّرُهُ[n[ۥ] لِلْعُسْرَىٰ"}, {"n": 11, "text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ", "taj": "وَمَا يُغْنِى عَنْهُ مَالُهُ[o[ۥٓ] إِذَا تَرَدَّىٰٓ"}, {"n": 12, "text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ", "taj": "إِ[g[نّ]َ عَلَيْنَا لَلْهُدَىٰ"}, {"n": 13, "text": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ", "taj": "وَإِ[g[نّ]َ لَنَا لَلْأَخِرَةَ وَ[h:12987[ٱ]لْأُولَىٰ"}, {"n": 14, "text": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ", "taj": "فَأَ[f:14533[نذ]َرْتُكُمْ نَا[f:14534[رًا ت]َلَظَّىٰ"}, {"n": 15, "text": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى", "taj": "لَا يَصْلَ[n[ـٰ]ه[o[َآ] إِلَّا [h:14535[ٱ]لْأَشْقَى"}, {"n": 16, "text": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ", "taj": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"}, {"n": 17, "text": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى", "taj": "وَسَيُجَ[g[نّ]َبُهَا [h:14536[ٱ]لْأَتْقَى"}, {"n": 18, "text": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ", "taj": "ٱلَّذِى يُؤْتِى مَالَهُ[n[ۥ] يَتَزَكَّىٰ"}, {"n": 19, "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ", "taj": "وَمَا لِأَحَدٍ عِ[f:719[ند]َهُ[n[ۥ] م[a:7433[ِن ن]ِّعْمَ[f:14537[ةٍ ت]ُ[q:11814[جْ]زَىٰٓ"}, {"n": 20, "text": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ", "taj": "إِلَّا [h:1610[ٱ][q:1130[بْ]تِغ[o[َا]ٓءَ وَ[q:1611[جْ]هِ رَبِّهِ [h:14538[ٱ]لْأَعْلَىٰ"}, {"n": 21, "text": "وَلَسَوْفَ يَرْضَىٰ", "taj": "وَلَسَوْفَ يَرْضَىٰ"}]}