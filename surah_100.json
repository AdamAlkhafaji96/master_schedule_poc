{"number": 100, "name": "سُورَةُ العَادِيَاتِ", "englishName": "Al-Aadiyaat", "englishNameTranslation": "The Chargers", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا", "taj": "وَ[h:9999[ٱ]لْعَ[n[ـٰ]دِيَ[n[ـٰ]تِ ضَ[q:14611[بْ]حًا"}, {"n": 2, "text": "فَٱلْمُورِيَٰتِ قَدْحًۭا", "taj": "فَ[h:9999[ٱ]لْمُورِيَ[n[ـٰ]تِ قَ[q:14612[دْ]حًا"}, {"n": 3, "text": "فَٱلْمُغِيرَٰتِ صُبْحًۭا", "taj": "فَ[h:9999[ٱ]لْمُغِير[n[َٲ]تِ صُ[q:14613[بْ]حًا"}, {"n": 4, "text": "فَأَثَرْنَ بِهِۦ نَقْعًۭا", "taj": "فَأَثَرْنَ بِه[n[ِۦ] نَ[q:14614[قْ]عًا"}, {"n": 5, "text": "فَوَسَطْنَ بِهِۦ جَمْعًا", "taj": "فَوَسَ[q:14615[طْ]نَ بِه[n[ِۦ] جَمْعًا"}, {"n": 6, "text": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ", "taj": "إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لِرَبِّه[n[ِۦ] لَكَن[p[ُو][q[د]ٌ"}, {"n": 7, "text": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ", "taj": "وَإِ[g[نّ]َهُ[n[ۥ] عَلَىٰ ذ[n[َٲ]لِكَ لَشَه[p[ِي][q[د]ٌ"}, {"n": 8, "text": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ", "taj": "وَإِ[g[نّ]َهُ[n[ۥ] لِحُبِّ [h:14616[ٱ]لْخَيْرِ لَشَد[p[ِي][q[د]ٌ"}, {"n": 9, "text": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ", "taj": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى [h:8926[ٱ]لْقُب[p[ُو]رِ"}, {"n": 10, "text": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ", "taj": "وَحُصِّلَ مَا فِى [h:6095[ٱ][l[ل]صُّد[p[ُو]رِ"}, {"n": 11, "text": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ", "taj": "إِ[g[نّ]َ رَبَّه[c:14617[ُم ب]ِهِمْ يَوْمَئِ[u:14618[ذٍ ل]َّخَب[p[ِي]رُۢ"}]}