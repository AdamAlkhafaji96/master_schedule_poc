{"number": 81, "name": "سُورَةُ التَّكۡوِيرِ", "englishName": "At-Takwir", "englishNameTranslation": "The Overthrowing", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ", "taj": "إِذَا [h:14331[ٱ][l[ل]شَّمْسُ كُوِّرَتْ"}, {"n": 2, "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "taj": "وَإِذَا [h:14332[ٱ][l[ل][g[نّ]ُجُومُ [h:14333[ٱ][f:14334[نك]َدَرَتْ"}, {"n": 3, "text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ", "taj": "وَإِذَا [h:14211[ٱ]لْجِبَالُ سُيِّرَتْ"}, {"n": 4, "text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ", "taj": "وَإِذَا [h:14335[ٱ]لْعِشَارُ عُطِّلَتْ"}, {"n": 5, "text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ", "taj": "وَإِذَا [h:14336[ٱ]لْوُحُوشُ حُشِرَتْ"}, {"n": 6, "text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ", "taj": "وَإِذَا [h:14337[ٱ]لْبِحَارُ سُجِّرَتْ"}, {"n": 7, "text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ", "taj": "وَإِذَا [h:14338[ٱ][l[ل][g[نّ]ُفُوسُ زُوِّجَتْ"}, {"n": 8, "text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ", "taj": "وَإِذَا [h:14339[ٱ]لْمَوْءُ[n[ۥ]دَةُ سُئِلَتْ"}, {"n": 9, "text": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "taj": "بِأَىِّ ذَ[i:14340[نۢب][f:14341[ٍ ق]ُتِلَتْ"}, {"n": 10, "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "taj": "وَإِذَا [h:14342[ٱ][l[ل]صُّحُفُ نُشِرَتْ"}, {"n": 11, "text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "taj": "وَإِذَا [h:14210[ٱ][l[ل]سَّم[o[َا]ٓءُ كُشِطَتْ"}, {"n": 12, "text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "taj": "وَإِذَا [h:14343[ٱ]لْجَحِيمُ سُعِّرَتْ"}, {"n": 13, "text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "taj": "وَإِذَا [h:14344[ٱ]لْجَ[g[نّ]َةُ أُزْلِفَتْ"}, {"n": 14, "text": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "taj": "عَلِمَتْ نَفْ[a:10644[سٌ م]ّ[o[َآ] أَحْضَرَتْ"}, {"n": 15, "text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ", "taj": "فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِ[h:14345[ٱ]لْخُ[g[نّ]َسِ"}, {"n": 16, "text": "ٱلْجَوَارِ ٱلْكُنَّسِ", "taj": "ٱلْجَوَارِ [h:14346[ٱ]لْكُ[g[نّ]َسِ"}, {"n": 17, "text": "وَٱلَّيْلِ إِذَا عَسْعَسَ", "taj": "وَ[h:9999[ٱ]لَّيْلِ إِذَا عَسْعَسَ"}, {"n": 18, "text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ", "taj": "وَ[h:9999[ٱ][l[ل]صُّ[q:14092[بْ]حِ إِذَا تَنَفَّسَ"}, {"n": 19, "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "taj": "إِ[g[نّ]َهُ[n[ۥ] لَقَوْلُ رَسُو[f:13904[لٍ ك]َر[p[ِي]مٍ"}, {"n": 20, "text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ", "taj": "ذِى قُوَّةٍ عِ[f:264[ند]َ ذِى [h:7769[ٱ]لْعَرْشِ مَك[p[ِي]نٍ"}, {"n": 21, "text": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ", "taj": "مُّطَا[f:14347[عٍ ث]َ[g[مّ]َ أَم[p[ِي]نٍ"}, {"n": 22, "text": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ", "taj": "وَمَا صَاحِبُك[c:14348[ُم ب]ِمَ[q:13812[جْ]ن[p[ُو]نٍ"}, {"n": 23, "text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ", "taj": "وَلَقَ[q:341[دْ] رَءَاهُ بِ[h:12961[ٱ]لْأُفُقِ [h:14349[ٱ]لْمُب[p[ِي]نِ"}, {"n": 24, "text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ", "taj": "وَمَا هُوَ عَلَى [h:2453[ٱ]لْغَيْبِ بِضَن[p[ِي]نٍ"}, {"n": 25, "text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ", "taj": "وَمَا هُوَ بِقَوْلِ شَيْطَ[n[ـٰ][u:7213[نٍ ر]َّج[p[ِي]مٍ"}, {"n": 26, "text": "فَأَيْنَ تَذْهَبُونَ", "taj": "فَأَيْنَ تَذْهَب[p[ُو]نَ"}, {"n": 27, "text": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "taj": "إِنْ هُوَ إِلَّا ذِكْ[u:6839[رٌ ل]ِّلْعَ[n[ـٰ]لَم[p[ِي]نَ"}, {"n": 28, "text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ", "taj": "لِمَ[f:14095[ن ش][o[َا]ٓءَ مِ[f:344[نك]ُمْ أ[a:14350[َن ي]َسْتَق[p[ِي]مَ"}, {"n": 29, "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ", "taj": "وَمَا تَش[o[َا]ٓءُونَ إِلّ[o[َآ] أ[a:4201[َن ي]َش[o[َا]ٓءَ [h:4334[ٱ]للَّهُ رَبُّ [h:4750[ٱ]لْعَ[n[ـٰ]لَم[p[ِي]نَ"}]}