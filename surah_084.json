{"number": 84, "name": "سُورَةُ الانشِقَاقِ", "englishName": "Al-Inshiqaaq", "englishNameTranslation": "The Splitting Open", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ", "taj": "إِذَا [h:14351[ٱ][l[ل]سَّم[o[َا]ٓءُ [h:14390[ٱ][f:14391[نش]َقَّتْ"}, {"n": 2, "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "taj": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"}, {"n": 3, "text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ", "taj": "وَإِذَا [h:14392[ٱ]لْأَرْضُ مُدَّتْ"}, {"n": 4, "text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ", "taj": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"}, {"n": 5, "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "taj": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"}, {"n": 6, "text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ", "taj": "يَ[o[ـٰٓ]أَيُّهَا [h:14358[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ إِ[g[نّ]َكَ كَادِحٌ إِلَىٰ رَبِّكَ كَ[q:14393[دْ][f:14394[حًا ف]َمُلَ[n[ـٰ]ق[p[ِي]هِ"}, {"n": 7, "text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ", "taj": "فَأَ[g[مّ]َا مَنْ أُوتِىَ كِتَ[n[ـٰ]بَهُ[n[ۥ] بِيَمِينِهِۦ"}, {"n": 8, "text": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا", "taj": "فَسَوْفَ يُحَاسَبُ حِسَا[a:14395[بًا ي]َسِيرًا"}, {"n": 9, "text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا", "taj": "وَيَ[f:14396[نق]َلِبُ إِلَ[o[ىٰٓ] أَهْلِه[n[ِۦ] مَسْرُورًا"}, {"n": 10, "text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ", "taj": "وَأَ[g[مّ]َا مَنْ أُوتِىَ كِتَ[n[ـٰ]بَهُ[n[ۥ] وَر[o[َا]ٓءَ ظَهْرِهِۦ"}, {"n": 11, "text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا", "taj": "فَسَوْفَ يَ[q:1242[دْ]عُو[s[اْ] ثُبُورًا"}, {"n": 12, "text": "وَيَصْلَىٰ سَعِيرًا", "taj": "وَيَصْلَىٰ سَعِيرًا"}, {"n": 13, "text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا", "taj": "إِ[g[نّ]َهُ[n[ۥ] كَانَ ف[o[ِىٓ] أَهْلِه[n[ِۦ] مَسْرُورًا"}, {"n": 14, "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ", "taj": "إِ[g[نّ]َهُ[n[ۥ] ظَ[g[نّ]َ أ[u:8842[َن ل]ّ[a:14397[َن ي]َح[p[ُو]رَ"}, {"n": 15, "text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا", "taj": "بَلَ[o[ىٰٓ] إِ[g[نّ]َ رَبَّهُ[n[ۥ] كَانَ بِه[n[ِۦ] بَصِيرًا"}, {"n": 16, "text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ", "taj": "فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِ[h:14398[ٱ][l[ل]شَّفَ[q[ق]ِ"}, {"n": 17, "text": "وَٱلَّيْلِ وَمَا وَسَقَ", "taj": "وَ[h:9999[ٱ]لَّيْلِ وَمَا وَسَ[q[ق]َ"}, {"n": 18, "text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ", "taj": "وَ[h:9999[ٱ]لْقَمَرِ إِذَا [h:14399[ٱ]تَّسَ[q[ق]َ"}, {"n": 19, "text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ", "taj": "لَتَرْكَبُ[g[نّ]َ طَبَقًا عَ[f:14400[ن ط]َبَ[q[ق]ٍ"}, {"n": 20, "text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ", "taj": "فَمَا لَهُمْ لَا يُؤْمِن[p[ُو]نَ"}, {"n": 21, "text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩", "taj": "وَإِذَا قُرِئَ عَلَيْهِمُ [h:14401[ٱ]لْقُرْءَانُ لَا يَسْجُدُ[p[و]نَ ۩"}, {"n": 22, "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ", "taj": "بَلِ [h:10932[ٱ]لَّذِينَ كَفَرُو[s[اْ] يُكَذِّب[p[ُو]نَ"}, {"n": 23, "text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ", "taj": "وَ[h:9999[ٱ]للَّهُ أَعْلَمُ بِمَا يُوع[p[ُو]نَ"}, {"n": 24, "text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ", "taj": "فَبَشِّرْه[c:1811[ُم ب]ِعَذَابٍ أَل[p[ِي]مٍ"}, {"n": 25, "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ", "taj": "إِلَّا [h:778[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَعَمِلُو[s[اْ] [h:118[ٱ][l[ل]صَّ[n[ـٰ]لِحَ[n[ـٰ]تِ لَهُمْ أَ[q:2423[جْ]رٌ غَيْرُ مَمْن[p[ُو]نِۭ"}]}