{"number": 75, "name": "سُورَةُ القِيَامَةِ", "englishName": "Al-Qiyaama", "englishNameTranslation": "The Resurrection", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ", "taj": "ل[o[َآ] أُ[q:13287[قْ]سِمُ بِيَوْمِ [h:14115[ٱ]لْقِيَ[n[ـٰ]مَةِ"}, {"n": 2, "text": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ", "taj": "وَل[o[َآ] أُ[q:13287[قْ]سِمُ بِ[h:3575[ٱ][l[ل][g[نّ]َفْسِ [h:14116[ٱ][l[ل]لَّوَّامَةِ"}, {"n": 3, "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ", "taj": "أَيَحْسَبُ [h:14117[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ أَلّ[a:14118[َن ن]َّ[q:14119[جْ]مَعَ عِظَامَهُۥ"}, {"n": 4, "text": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ", "taj": "بَلَىٰ قَ[n[ـٰ]دِرِينَ عَلَ[o[ىٰٓ] أ[a:14120[َن ن]ُّسَوِّىَ بَنَانَهُۥ"}, {"n": 5, "text": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ", "taj": "بَلْ يُرِيدُ [h:14121[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ لِيَفْجُرَ أَمَامَهُۥ"}, {"n": 6, "text": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ", "taj": "يَسْــَٔلُ أَيَّانَ يَوْمُ [h:14122[ٱ]لْقِيَ[n[ـٰ]مَةِ"}, {"n": 7, "text": "فَإِذَا بَرِقَ ٱلْبَصَرُ", "taj": "فَإِذَا بَرِقَ [h:14123[ٱ]لْبَصَرُ"}, {"n": 8, "text": "وَخَسَفَ ٱلْقَمَرُ", "taj": "وَخَسَفَ [h:14124[ٱ]لْقَمَرُ"}, {"n": 9, "text": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ", "taj": "وَجُمِعَ [h:14125[ٱ][l[ل]شَّمْسُ وَ[h:8956[ٱ]لْقَمَرُ"}, {"n": 10, "text": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ", "taj": "يَقُولُ [h:14126[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ يَوْمَئِذٍ أَيْنَ [h:14127[ٱ]لْمَفَرُّ"}, {"n": 11, "text": "كَلَّا لَا وَزَرَ", "taj": "كَلَّا لَا وَزَرَ"}, {"n": 12, "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ", "taj": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ [h:14128[ٱ]لْمُسْتَقَرُّ"}, {"n": 13, "text": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ", "taj": "يُنَبَّؤُ[s[اْ] [h:14129[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ يَوْمَئِ[i:14130[ذِۭ ب]ِمَا قَدَّمَ وَأَخَّرَ"}, {"n": 14, "text": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ", "taj": "بَلِ [h:14131[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ عَلَىٰ نَفْسِه[n[ِۦ] بَصِيرَةٌ"}, {"n": 15, "text": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ", "taj": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"}, {"n": 16, "text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ", "taj": "لَا تُحَرِّكْ بِه[n[ِۦ] لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"}, {"n": 17, "text": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ", "taj": "إِ[g[نّ]َ عَلَيْنَا جَمْعَهُ[n[ۥ] وَقُرْءَانَهُۥ"}, {"n": 18, "text": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ", "taj": "فَإِذَا قَرَأْنَ[n[ـٰ]هُ فَ[h:14132[ٱ]تَّبِعْ قُرْءَانَهُۥ"}, {"n": 19, "text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ", "taj": "ثُ[g[مّ]َ إِ[g[نّ]َ عَلَيْنَا بَيَانَهُۥ"}, {"n": 20, "text": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ", "taj": "كَلَّا بَلْ تُحِبُّونَ [h:14133[ٱ]لْعَاجِلَةَ"}, {"n": 21, "text": "وَتَذَرُونَ ٱلْءَاخِرَةَ", "taj": "وَتَذَرُونَ [h:14134[ٱ]لْأَخِرَةَ"}, {"n": 22, "text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ", "taj": "وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14136[ذٍ ن]َّاضِرَةٌ"}, {"n": 23, "text": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ", "taj": "إِلَىٰ رَبِّهَا نَاظِرَةٌ"}, {"n": 24, "text": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ", "taj": "وَوُجُو[a:14137[هٌ ي]َوْمَئِ[i:14138[ذِۭ ب]َاسِرَةٌ"}, {"n": 25, "text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ", "taj": "تَظُ[g[نّ]ُ أ[a:14139[َن ي]ُفْعَلَ بِهَا فَاقِرَةٌ"}, {"n": 26, "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ", "taj": "كَلّ[o[َآ] إِذَا بَلَغَتِ [h:14140[ٱ][l[ل]تَّرَاقِىَ"}, {"n": 27, "text": "وَقِيلَ مَنْ ۜ رَاقٍۢ", "taj": "وَقِيلَ م[u:14141[َنْۜ ر][p[َا][q[ق]ٍ"}, {"n": 28, "text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ", "taj": "وَظَ[g[نّ]َ أَ[g[نّ]َهُ [h:14142[ٱ]لْفِر[p[َا][q[ق]ُ"}, {"n": 29, "text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ", "taj": "وَ[h:9999[ٱ]لْتَفَّتِ [h:14143[ٱ][l[ل]سَّاقُ بِ[h:14144[ٱ][l[ل]سّ[p[َا][q[ق]ِ"}, {"n": 30, "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ", "taj": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ [h:14145[ٱ]لْمَس[p[َا][q[ق]ُ"}, {"n": 31, "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ", "taj": "فَلَا صَدَّقَ وَلَا صَلَّىٰ"}, {"n": 32, "text": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ", "taj": "وَلَ[n[ـٰ]كِ[f:14146[ن ك]َذَّبَ وَتَوَلَّىٰ"}, {"n": 33, "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ", "taj": "ثُ[g[مّ]َ ذَهَبَ إِلَ[o[ىٰٓ] أَهْلِه[n[ِۦ] يَتَمَطَّىٰٓ"}, {"n": 34, "text": "أَوْلَىٰ لَكَ فَأَوْلَىٰ", "taj": "أَوْلَىٰ لَكَ فَأَوْلَىٰ"}, {"n": 35, "text": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ", "taj": "ثُ[g[مّ]َ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"}, {"n": 36, "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى", "taj": "أَيَحْسَبُ [h:14117[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ أ[a:14147[َن ي]ُتْرَكَ سُدًى"}, {"n": 37, "text": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ", "taj": "أَلَمْ يَكُ نُ[q:9146[طْ]فَ[a:14148[ةً م]ّ[a:14149[ِن م]َّنِ[a:14150[ىٍّ ي]ُمْنَىٰ"}, {"n": 38, "text": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ", "taj": "ثُ[g[مّ]َ كَانَ عَلَقَ[f:14151[ةً ف]َخَلَقَ فَسَوَّىٰ"}, {"n": 39, "text": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "taj": "فَجَعَلَ مِنْهُ [h:14152[ٱ][l[ل]زَّوْجَيْنِ [h:13018[ٱ][l[ل]ذَّكَرَ وَ[h:929[ٱ]لْأُ[f:929[نث]َىٰٓ"}, {"n": 40, "text": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ", "taj": "أَلَيْسَ ذ[n[َٲ]لِكَ بِقَ[n[ـٰ]دِرٍ عَلَ[o[ىٰٓ] أ[a:12519[َن ي]ُحْــِۧىَ [h:12520[ٱ]لْمَوْتَىٰ"}]}