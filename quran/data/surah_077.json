{"number": 77, "name": "سُورَةُ المُرۡسَلَاتِ", "englishName": "Al-Mursalaat", "englishNameTranslation": "The Emissaries", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا", "taj": "وَ[h:9999[ٱ]لْمُرْسَلَ[n[ـٰ]تِ عُرْفًا"}, {"n": 2, "text": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا", "taj": "فَ[h:9999[ٱ]لْعَ[n[ـٰ]صِفَ[n[ـٰ]تِ عَصْفًا"}, {"n": 3, "text": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا", "taj": "وَ[h:9999[ٱ][l[ل][g[نّ]َ[n[ـٰ]شِر[n[َٲ]تِ نَشْرًا"}, {"n": 4, "text": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا", "taj": "فَ[h:9999[ٱ]لْفَ[n[ـٰ]رِقَ[n[ـٰ]تِ فَرْقًا"}, {"n": 5, "text": "فَٱلْمُلْقِيَٰتِ ذِكْرًا", "taj": "فَ[h:9999[ٱ]لْمُلْقِيَ[n[ـٰ]تِ ذِكْرًا"}, {"n": 6, "text": "عُذْرًا أَوْ نُذْرًا", "taj": "عُذْرًا أَوْ نُذْرًا"}, {"n": 7, "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ", "taj": "إِ[g[نّ]َمَا تُوعَدُونَ لَو[n[َٲ]قِعٌ"}, {"n": 8, "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ", "taj": "فَإِذَا [h:14209[ٱ][l[ل][g[نّ]ُجُومُ طُمِسَتْ"}, {"n": 9, "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ", "taj": "وَإِذَا [h:14210[ٱ][l[ل]سَّم[o[َا]ٓءُ فُرِجَتْ"}, {"n": 10, "text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ", "taj": "وَإِذَا [h:14211[ٱ]لْجِبَالُ نُسِفَتْ"}, {"n": 11, "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ", "taj": "وَإِذَا [h:14212[ٱ][l[ل]رُّسُلُ أُقِّتَتْ"}, {"n": 12, "text": "لِأَىِّ يَوْمٍ أُجِّلَتْ", "taj": "لِأَىِّ يَوْمٍ أُجِّلَتْ"}, {"n": 13, "text": "لِيَوْمِ ٱلْفَصْلِ", "taj": "لِيَوْمِ [h:14213[ٱ]لْفَصْلِ"}, {"n": 14, "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ", "taj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11336[ٱ]لْفَصْلِ"}, {"n": 15, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "taj": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"n": 16, "text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ", "taj": "أَلَمْ نُهْلِكِ [h:14215[ٱ]لْأَوَّل[p[ِي]نَ"}, {"n": 17, "text": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ", "taj": "ثُ[g[مّ]َ نُتْبِعُهُمُ [h:14216[ٱ]لْأَخِر[p[ِي]نَ"}, {"n": 18, "text": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ", "taj": "كَذ[n[َٲ]لِكَ نَفْعَلُ بِ[h:11348[ٱ]لْمُ[q:11348[جْ]رِم[p[ِي]نَ"}, {"n": 19, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "taj": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"n": 20, "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ", "taj": "أَلَمْ نَخْلُ[b:14217[ق]كّ[w:14218[ُم م]ّ[a:840[ِن م]ّ[o[َا]ٓ[a:10629[ءٍ م]َّه[p[ِي]نٍ"}, {"n": 21, "text": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ", "taj": "فَجَعَلْنَ[n[ـٰ]هُ فِى قَرَا[a:9148[رٍ م]َّك[p[ِي]نٍ"}, {"n": 22, "text": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ", "taj": "إِلَىٰ قَدَ[a:14219[رٍ م]َّعْل[p[ُو]مٍ"}, {"n": 23, "text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ", "taj": "فَقَدَرْنَا فَنِعْمَ [h:14220[ٱ]لْقَ[n[ـٰ]دِر[p[ُو]نَ"}, {"n": 24, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "taj": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"n": 25, "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا", "taj": "أَلَمْ نَ[q:14221[جْ]عَلِ [h:14222[ٱ]لْأَرْضَ كِفَاتًا"}, {"n": 26, "text": "أَحْيَآءًۭ وَأَمْوَٰتًۭا", "taj": "أَحْي[o[َا]ٓ[a:14223[ءً و]َأَمْو[n[َٲ]تًا"}, {"n": 27, "text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا", "taj": "وَجَعَلْنَا فِيهَا رَو[n[َٲ]سِىَ شَ[n[ـٰ]مِخَ[n[ـٰ][a:14224[تٍ و]َأَسْقَيْنَ[n[ـٰ]ك[w:14225[ُم م]ّ[o[َا]ٓ[f:14226[ءً ف]ُرَاتًا"}, {"n": 28, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "taj": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"n": 29, "text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ", "taj": "ٱ[f:14227[نط]َلِق[o[ُوٓ][s[اْ] إِلَىٰ مَا كُ[f:100[نت][c:6084[ُم ب]ِه[n[ِۦ] تُكَذِّب[p[ُو]نَ"}, {"n": 30, "text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ", "taj": "ٱ[f:14227[نط]َلِق[o[ُوٓ][s[اْ] إِلَىٰ ظِ[f:14228[لٍّ ذ]ِى ثَلَ[n[ـٰ]ثِ شُعَ[q[ب]ٍ"}, {"n": 31, "text": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ", "taj": "لَّا ظَلِي[a:14229[لٍ و]َلَا يُغْنِى مِنَ [h:14230[ٱ][l[ل]لَّهَ[q[ب]ِ"}, {"n": 32, "text": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ", "taj": "إِ[g[نّ]َهَا تَرْمِى بِشَرَ[f:14231[رٍ ك]َ[h:14232[ٱ]لْقَصْرِ"}, {"n": 33, "text": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ", "taj": "كَأَ[g[نّ]َهُ[n[ۥ] جِمَ[n[ـٰ]لَ[f:14233[تٌ ص]ُفْرٌ"}, {"n": 34, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "taj": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"n": 35, "text": "هَٰذَا يَوْمُ لَا يَنطِقُونَ", "taj": "هَ[n[ـٰ]ذَا يَوْمُ لَا يَ[f:8795[نط]ِق[p[ُو]نَ"}, {"n": 36, "text": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ", "taj": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِر[p[ُو]نَ"}, {"n": 37, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "taj": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"n": 38, "text": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ", "taj": "هَ[n[ـٰ]ذَا يَوْمُ [h:11336[ٱ]لْفَصْلِ‌ۖ جَمَعْنَ[n[ـٰ]كُمْ وَ[h:14234[ٱ]لْأَوَّل[p[ِي]نَ"}, {"n": 39, "text": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ", "taj": "فَإِ[f:1670[ن ك]َانَ لَكُمْ كَيْ[f:14235[دٌ ف]َكِيد[p[ُو]نِ"}, {"n": 40, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "taj": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"n": 41, "text": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ", "taj": "إِ[g[نّ]َ [h:7256[ٱ]لْمُتَّقِينَ فِى ظِلَ[n[ـٰ][a:14236[لٍ و]َعُي[p[ُو]نٍ"}, {"n": 42, "text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ", "taj": "وَفَو[n[َٲ]كِهَ مِ[g[مّ]َا يَشْتَه[p[ُو]نَ"}, {"n": 43, "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ", "taj": "كُلُو[s[اْ] وَ[h:300[ٱ]شْرَبُو[s[اْ] هَنِ[o[يٓـ]ـ[i:12907[ـَٔۢا ب]ِمَا كُ[f:100[نت]ُمْ تَعْمَل[p[ُو]نَ"}, {"n": 44, "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "taj": "إِ[g[نّ]َا كَذ[n[َٲ]لِكَ نَ[q:4214[جْ]زِى [h:4215[ٱ]لْمُحْسِن[p[ِي]نَ"}, {"n": 45, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "taj": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"n": 46, "text": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ", "taj": "كُلُو[s[اْ] وَتَمَتَّعُو[s[اْ] قَلِيلاً إِ[g[نّ]َك[w:14237[ُم م]ُّ[q:12353[جْ]رِم[p[ُو]نَ"}, {"n": 47, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "taj": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"n": 48, "text": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ", "taj": "وَإِذَا قِيلَ لَهُمُ [h:14238[ٱ]رْكَعُو[s[اْ] لَا يَرْكَع[p[ُو]نَ"}, {"n": 49, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "taj": "وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"}, {"n": 50, "text": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ", "taj": "فَبِأَىِّ حَدِي[i:5170[ثِۭ ب]َعْدَهُ[n[ۥ] يُؤْمِن[p[ُو]نَ"}]}