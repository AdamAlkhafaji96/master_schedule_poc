{"number": 94, "name": "سُورَةُ الشَّرۡحِ", "englishName": "Ash-Sharh", "englishNameTranslation": "The Consolation", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ", "taj": "أَلَمْ نَشْرَحْ لَكَ صَ[q:14548[دْ]رَكَ"}, {"n": 2, "text": "وَوَضَعْنَا عَنكَ وِزْرَكَ", "taj": "وَوَضَعْنَا عَ[f:626[نك]َ وِزْرَكَ"}, {"n": 3, "text": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ", "taj": "ٱلَّذ[o[ِىٓ] أَ[f:14549[نق]َضَ ظَهْرَكَ"}, {"n": 4, "text": "وَرَفَعْنَا لَكَ ذِكْرَكَ", "taj": "وَرَفَعْنَا لَكَ ذِكْرَكَ"}, {"n": 5, "text": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا", "taj": "فَإِ[g[نّ]َ مَعَ [h:14550[ٱ]لْعُسْرِ يُسْرًا"}, {"n": 6, "text": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا", "taj": "إِ[g[نّ]َ مَعَ [h:14550[ٱ]لْعُسْرِ يُسْرًا"}, {"n": 7, "text": "فَإِذَا فَرَغْتَ فَٱنصَبْ", "taj": "فَإِذَا فَرَغْتَ فَ[h:14551[ٱ][f:14551[نص]َ[q:14551[بْ]"}, {"n": 8, "text": "وَإِلَىٰ رَبِّكَ فَٱرْغَب", "taj": "وَإِلَىٰ رَبِّكَ فَ[h:14552[ٱ]رْغَ[q[ب]"}]}