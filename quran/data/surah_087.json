{"number": 87, "name": "سُورَةُ الأَعۡلَىٰ", "englishName": "Al-A'laa", "englishNameTranslation": "The Most High", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى", "taj": "سَبِّحِ [h:14437[ٱ]سْمَ رَبِّكَ [h:14438[ٱ]لْأَعْلَى"}, {"n": 2, "text": "ٱلَّذِى خَلَقَ فَسَوَّىٰ", "taj": "ٱلَّذِى خَلَقَ فَسَوَّىٰ"}, {"n": 3, "text": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ", "taj": "وَ[h:9999[ٱ]لَّذِى قَدَّرَ فَهَدَىٰ"}, {"n": 4, "text": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ", "taj": "وَ[h:9999[ٱ]لَّذ[o[ِىٓ] أَخْرَجَ [h:14439[ٱ]لْمَرْعَىٰ"}, {"n": 5, "text": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ", "taj": "فَجَعَلَهُ[n[ۥ] غُث[o[َا]ٓءً أَحْوَىٰ"}, {"n": 6, "text": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ", "taj": "سَنُ[q:14440[قْ]رِئُكَ فَلَا تَ[f:14441[نس]َىٰٓ"}, {"n": 7, "text": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ", "taj": "إِلَّا مَا ش[o[َا]ٓءَ [h:78[ٱ]للَّهُ‌ۚ إِ[g[نّ]َهُ[n[ۥ] يَعْلَمُ [h:8891[ٱ]لْجَهْرَ وَمَا يَخْفَىٰ"}, {"n": 8, "text": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ", "taj": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ"}, {"n": 9, "text": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ", "taj": "فَذَكِّرْ إ[a:14442[ِن ن]َّفَعَتِ [h:14443[ٱ][l[ل]ذِّكْرَىٰ"}, {"n": 10, "text": "سَيَذَّكَّرُ مَن يَخْشَىٰ", "taj": "سَيَذَّكَّرُ م[a:14444[َن ي]َخْشَىٰ"}, {"n": 11, "text": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى", "taj": "وَيَتَجَ[g[نّ]َبُهَا [h:14445[ٱ]لْأَشْقَى"}, {"n": 12, "text": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ", "taj": "ٱلَّذِى يَصْلَى [h:14446[ٱ][l[ل][g[نّ]َارَ [h:14447[ٱ]لْكُ[q:8463[بْ]رَىٰ"}, {"n": 13, "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ", "taj": "ثُ[g[مّ]َ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"}, {"n": 14, "text": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ", "taj": "قَ[q:298[دْ] أَفْلَحَ مَ[f:8555[ن ت]َزَكَّىٰ"}, {"n": 15, "text": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ", "taj": "وَذَكَرَ [h:14448[ٱ]سْمَ رَبِّه[n[ِۦ] فَصَلَّىٰ"}, {"n": 16, "text": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "taj": "بَلْ تُؤْثِرُونَ [h:14449[ٱ]لْحَيَ[s[و][n[ٲ]ةَ [h:446[ٱ][l[ل]دُّنْيَا"}, {"n": 17, "text": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ", "taj": "وَ[h:9999[ٱ]لْأَخِرَةُ خَيْ[a:8546[رٌ و]َأَ[q:8540[بْ]قَىٰٓ"}, {"n": 18, "text": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ", "taj": "إِ[g[نّ]َ هَ[n[ـٰ]ذَا لَفِى [h:14450[ٱ][l[ل]صُّحُفِ [h:8657[ٱ]لْأُولَىٰ"}, {"n": 19, "text": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ", "taj": "صُحُفِ إِ[q:1860[بْ]ر[n[َٲ]هِيمَ وَمُوسَىٰ"}]}