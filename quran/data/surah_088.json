{"number": 88, "name": "سُورَةُ الغَاشِيَةِ", "englishName": "Al-Ghaashiya", "englishNameTranslation": "The Overwhelming", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "taj": "هَلْ أَتَ[n[ـٰ]كَ حَدِيثُ [h:14451[ٱ]لْغَ[n[ـٰ]شِيَةِ"}, {"n": 2, "text": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "taj": "وُجُو[a:14135[هٌ ي]َوْمَئِذٍ خَ[n[ـٰ]شِعَةٌ"}, {"n": 3, "text": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "taj": "عَامِلَ[a:14452[ةٌ ن]َّاصِبَةٌ"}, {"n": 4, "text": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "taj": "تَصْلَىٰ نَارًا حَامِيَةً"}, {"n": 5, "text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "taj": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"}, {"n": 6, "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "taj": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِ[f:14453[ن ض]َر[p[ِي]عٍ"}, {"n": 7, "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "taj": "لَّا يُسْمِنُ وَلَا يُغْنِى مِ[f:14454[ن ج][p[ُو]عٍ"}, {"n": 8, "text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ", "taj": "وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14455[ذٍ ن]َّاعِمَةٌ"}, {"n": 9, "text": "لِّسَعْيِهَا رَاضِيَةٌۭ", "taj": "لِّسَعْيِهَا رَاضِيَةٌ"}, {"n": 10, "text": "فِى جَنَّةٍ عَالِيَةٍۢ", "taj": "فِى جَ[g[نّ]َةٍ عَالِيَةٍ"}, {"n": 11, "text": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ", "taj": "لَّا تَسْمَعُ فِيهَا لَ[n[ـٰ]غِيَةً"}, {"n": 12, "text": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ", "taj": "فِيهَا عَيْ[f:14456[نٌ ج]َارِيَةٌ"}, {"n": 13, "text": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ", "taj": "فِيهَا سُرُ[a:14457[رٌ م]َّرْفُوعَةٌ"}, {"n": 14, "text": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ", "taj": "وَأَكْوَا[a:14458[بٌ م]َّوْضُوعَةٌ"}, {"n": 15, "text": "وَنَمَارِقُ مَصْفُوفَةٌۭ", "taj": "وَنَمَارِقُ مَصْفُوفَةٌ"}, {"n": 16, "text": "وَزَرَابِىُّ مَبْثُوثَةٌ", "taj": "وَزَرَابِىُّ مَ[q:14459[بْ]ثُوثَةٌ"}, {"n": 17, "text": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ", "taj": "أَفَلَا يَ[f:1141[نظ]ُرُونَ إِلَى [h:14460[ٱ]لْإِبِلِ كَيْفَ خُلِقَتْ"}, {"n": 18, "text": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ", "taj": "وَإِلَى [h:14461[ٱ][l[ل]سَّم[o[َا]ٓءِ كَيْفَ رُفِعَتْ"}, {"n": 19, "text": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ", "taj": "وَإِلَى [h:14462[ٱ]لْجِبَالِ كَيْفَ نُصِبَتْ"}, {"n": 20, "text": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ", "taj": "وَإِلَى [h:14463[ٱ]لْأَرْضِ كَيْفَ سُطِحَتْ"}, {"n": 21, "text": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ", "taj": "فَذَكِّرْ إِ[g[نّ]َم[o[َآ] أَ[f:169[نت]َ مُذَكِّرٌ"}, {"n": 22, "text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ", "taj": "لَّسْتَ عَلَيْه[c:14464[ِم ب]ِمُصَيْطِرٍ"}, {"n": 23, "text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ", "taj": "إِلَّا مَ[f:12995[ن ت]َوَلَّىٰ وَكَفَرَ"}, {"n": 24, "text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ", "taj": "فَيُعَذِّبُهُ [h:14465[ٱ]للَّهُ [h:14466[ٱ]لْعَذَابَ [h:14467[ٱ]لْأَكْبَرَ"}, {"n": 25, "text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "taj": "إِ[g[نّ]َ إِلَيْن[o[َآ] إِيَابَهُمْ"}, {"n": 26, "text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم", "taj": "ثُ[g[مّ]َ إِ[g[نّ]َ عَلَيْنَا حِسَابَهُم"}]}