{"number": 101, "name": "سُورَةُ القَارِعَةِ", "englishName": "Al-Qaari'a", "englishNameTranslation": "The Calamity", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ", "taj": "ٱلْقَارِعَةُ"}, {"n": 2, "text": "مَا ٱلْقَارِعَةُ", "taj": "مَا [h:14619[ٱ]لْقَارِعَةُ"}, {"n": 3, "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ", "taj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14619[ٱ]لْقَارِعَةُ"}, {"n": 4, "text": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ", "taj": "يَوْمَ يَكُونُ [h:14620[ٱ][l[ل][g[نّ]َاسُ كَ[h:14621[ٱ]لْفَرَاشِ [h:14622[ٱ]لْمَ[q:14623[بْ]ث[p[ُو]ثِ"}, {"n": 5, "text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ", "taj": "وَتَكُونُ [h:13919[ٱ]لْجِبَالُ كَ[h:13920[ٱ]لْعِهْنِ [h:14624[ٱ]لْمَ[f:14625[نف][p[ُو]شِ"}, {"n": 6, "text": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "taj": "فَأَ[g[مّ]َا مَ[f:14626[ن ث]َقُلَتْ مَو[n[َٲ]زِينُهُۥ"}, {"n": 7, "text": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "taj": "فَهُوَ فِى عِيشَ[u:13890[ةٍ ر]َّاضِيَةٍ"}, {"n": 8, "text": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "taj": "وَأَ[g[مّ]َا مَنْ خَفَّتْ مَو[n[َٲ]زِينُهُۥ"}, {"n": 9, "text": "فَأُمُّهُۥ هَاوِيَةٌۭ", "taj": "فَأُ[g[مّ]ُهُ[n[ۥ] هَاوِيَةٌ"}, {"n": 10, "text": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ", "taj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا هِيَهْ"}, {"n": 11, "text": "نَارٌ حَامِيَةٌۢ", "taj": "نَارٌ حَامِيَةُۢ"}]}