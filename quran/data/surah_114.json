{"number": 114, "name": "سُورَةُ النَّاسِ", "englishName": "An-Naas", "englishNameTranslation": "Mankind", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ", "taj": "قُلْ أَعُوذُ بِرَبِّ [h:14683[ٱ][l[ل][g[نّ][p[َا]سِ"}, {"n": 2, "text": "مَلِكِ ٱلنَّاسِ", "taj": "مَلِكِ [h:14684[ٱ][l[ل][g[نّ][p[َا]سِ"}, {"n": 3, "text": "إِلَٰهِ ٱلنَّاسِ", "taj": "إِلَ[n[ـٰ]هِ [h:14685[ٱ][l[ل][g[نّ][p[َا]سِ"}, {"n": 4, "text": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ", "taj": "مِ[f:14679[ن ش]َرِّ [h:14686[ٱ]لْوَسْوَاسِ [h:14687[ٱ]لْخَ[g[نّ][p[َا]سِ"}, {"n": 5, "text": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ", "taj": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ [h:14688[ٱ][l[ل][g[نّ][p[َا]سِ"}, {"n": 6, "text": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ", "taj": "مِنَ [h:6531[ٱ]لْجِ[g[نّ]َةِ وَ[h:824[ٱ][l[ل][g[نّ][p[َا]سِ"}]}