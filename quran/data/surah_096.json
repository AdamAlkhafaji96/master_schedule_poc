{"number": 96, "name": "سُورَةُ العَلَقِ", "englishName": "Al-Alaq", "englishNameTranslation": "The Clot", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ", "taj": "ٱ[q:7699[قْ]رَأْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:14559[ٱ]لَّذِى خَلَ[q[ق]َ"}, {"n": 2, "text": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ", "taj": "خَلَقَ [h:7324[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مِنْ عَلَ[q[ق]ٍ"}, {"n": 3, "text": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ", "taj": "ٱ[q:7699[قْ]رَأْ وَرَبُّكَ [h:14560[ٱ]لْأَكْرَمُ"}, {"n": 4, "text": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ", "taj": "ٱلَّذِى عَلَّمَ بِ[h:14561[ٱ]لْقَلَمِ"}, {"n": 5, "text": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ", "taj": "عَلَّمَ [h:14562[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مَا لَمْ يَعْلَمْ"}, {"n": 6, "text": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ", "taj": "كَلّ[o[َآ] إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لَيَ[q:14563[طْ]غَىٰٓ"}, {"n": 7, "text": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ", "taj": "أ[u:14564[َن ر]َّءَاهُ [h:14565[ٱ]سْتَغْنَىٰٓ"}, {"n": 8, "text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ", "taj": "إِ[g[نّ]َ إِلَىٰ رَبِّكَ [h:14566[ٱ][l[ل]رُّ[q:14567[جْ]عَىٰٓ"}, {"n": 9, "text": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ", "taj": "أَرَءَيْتَ [h:14568[ٱ]لَّذِى يَنْهَىٰ"}, {"n": 10, "text": "عَبْدًا إِذَا صَلَّىٰٓ", "taj": "عَ[q:3317[بْ]دًا إِذَا صَلَّىٰٓ"}, {"n": 11, "text": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ", "taj": "أَرَءَيْتَ إِ[f:2594[ن ك]َانَ عَلَى [h:4019[ٱ]لْهُدَىٰٓ"}, {"n": 12, "text": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ", "taj": "أَوْ أَمَرَ بِ[h:14569[ٱ][l[ل]تَّ[q:14569[قْ]وَىٰٓ"}, {"n": 13, "text": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ", "taj": "أَرَءَيْتَ إِ[f:14570[ن ك]َذَّبَ وَتَوَلَّىٰٓ"}, {"n": 14, "text": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ", "taj": "أَلَمْ يَعْل[c:14571[َم ب]ِأَ[g[نّ]َ [h:897[ٱ]للَّهَ يَرَىٰ"}, {"n": 15, "text": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ", "taj": "كَلَّا لَئ[u:4195[ِن ل]َّمْ يَ[f:10891[نت]َهِ لَنَسْفَع[i:14572[َۢا ب]ِ[h:14573[ٱ][l[ل][g[نّ]َاصِيَةِ"}, {"n": 16, "text": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ", "taj": "نَاصِيَ[f:14574[ةٍ ك]َ[n[ـٰ]ذِبَةٍ خَاطِئَةٍ"}, {"n": 17, "text": "فَلْيَدْعُ نَادِيَهُۥ", "taj": "فَلْيَ[q:14575[دْ]عُ نَادِيَهُۥ"}, {"n": 18, "text": "سَنَدْعُ ٱلزَّبَانِيَةَ", "taj": "سَنَ[q:14576[دْ]عُ [h:14577[ٱ][l[ل]زَّبَانِيَةَ"}, {"n": 19, "text": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩", "taj": "كَلَّا لَا تُطِعْهُ وَ[h:14578[ٱ]سْجُ[q:14578[دْ] وَ[h:14579[ٱ][q:14579[قْ]تَرِ[q[ب] ۩"}]}