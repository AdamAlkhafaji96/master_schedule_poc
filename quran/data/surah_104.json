{"number": 104, "name": "سُورَةُ الهُمَزَةِ", "englishName": "Al-Humaza", "englishNameTranslation": "The Traducer", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ", "taj": "وَيْ[u:12392[لٌ ل]ِّكُلِّ هُمَزَ[u:14633[ةٍ ل]ُّمَزَةٍ"}, {"n": 2, "text": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ", "taj": "ٱلَّذِى جَمَعَ مَال[a:14634[اً و]َعَدَّدَهُۥ"}, {"n": 3, "text": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ", "taj": "يَحْسَبُ أَ[g[نّ]َ مَالَهُ[o[ۥٓ] أَخْلَدَهُۥ"}, {"n": 4, "text": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ", "taj": "كَلَّا‌ۖ لَيُ[i:14635[نۢب]َذَ[g[نّ]َ فِى [h:14636[ٱ]لْحُطَمَةِ"}, {"n": 5, "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ", "taj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14637[ٱ]لْحُطَمَةُ"}, {"n": 6, "text": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ", "taj": "نَارُ [h:14638[ٱ]للَّهِ [h:14639[ٱ]لْمُوقَدَةُ"}, {"n": 7, "text": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ", "taj": "ٱلَّتِى تَطَّلِعُ عَلَى [h:14640[ٱ]لْأَفْــِٔدَةِ"}, {"n": 8, "text": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ", "taj": "إِ[g[نّ]َهَا عَلَيْه[w:14641[ِم م]ُّؤْصَدَةٌ"}, {"n": 9, "text": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ", "taj": "فِى عَمَ[a:14642[دٍ م]ُّمَدَّدَةِۭ"}]}