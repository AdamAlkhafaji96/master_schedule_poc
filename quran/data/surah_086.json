{"number": 86, "name": "سُورَةُ الطَّارِقِ", "englishName": "At-Taariq", "englishNameTranslation": "The Morning Star", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ", "taj": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ وَ[h:14418[ٱ][l[ل]طَّارِ[q[ق]ِ"}, {"n": 2, "text": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ", "taj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14419[ٱ][l[ل]طَّارِ[q[ق]ُ"}, {"n": 3, "text": "ٱلنَّجْمُ ٱلثَّاقِبُ", "taj": "ٱ[l[ل][g[نّ]َ[q:14420[جْ]مُ [h:14421[ٱ][l[ل]ثَّاقِ[q[ب]ُ"}, {"n": 4, "text": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ", "taj": "إِ[f:8426[ن ك]ُلُّ نَفْ[u:14422[سٍ ل]َّ[g[مّ]َا عَلَيْهَا حَافِظٌ"}, {"n": 5, "text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ", "taj": "فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مِ[g[مّ]َ خُلِ[q[ق]َ"}, {"n": 6, "text": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ", "taj": "خُلِقَ م[a:840[ِن م]ّ[o[َا]ٓ[f:14423[ءٍ د]َافِ[q[ق]ٍ"}, {"n": 7, "text": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ", "taj": "يَخْرُجُ م[i:4612[ِنۢ ب]َيْنِ [h:14424[ٱ][l[ل]صُّلْبِ وَ[h:14425[ٱ][l[ل]تَّر[o[َا]ٓئِ[q[ب]ِ"}, {"n": 8, "text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ", "taj": "إِ[g[نّ]َهُ[n[ۥ] عَلَىٰ رَ[q:14426[جْ]عِه[n[ِۦ] لَقَادِرٌ"}, {"n": 9, "text": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ", "taj": "يَوْمَ تُ[q:14427[بْ]لَى [h:14428[ٱ][l[ل]سَّر[o[َا]ٓئِرُ"}, {"n": 10, "text": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ", "taj": "فَمَا لَهُ[n[ۥ] مِ[f:5395[ن ق]ُوَّ[a:14429[ةٍ و]َلَا نَاصِرٍ"}, {"n": 11, "text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ", "taj": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ ذَاتِ [h:14430[ٱ][l[ل]رَّ[q:14431[جْ]عِ"}, {"n": 12, "text": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ", "taj": "وَ[h:9999[ٱ]لْأَرْضِ ذَاتِ [h:14432[ٱ][l[ل]صَّ[q:14433[دْ]عِ"}, {"n": 13, "text": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ", "taj": "إِ[g[نّ]َهُ[n[ۥ] لَقَوْ[f:14434[لٌ ف]َصْلٌ"}, {"n": 14, "text": "وَمَا هُوَ بِٱلْهَزْلِ", "taj": "وَمَا هُوَ بِ[h:14435[ٱ]لْهَزْلِ"}, {"n": 15, "text": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا", "taj": "إِ[g[نّ]َهُمْ يَكِيدُونَ كَيْدًا"}, {"n": 16, "text": "وَأَكِيدُ كَيْدًۭا", "taj": "وَأَكِيدُ كَيْدًا"}, {"n": 17, "text": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا", "taj": "فَمَهِّلِ [h:14436[ٱ]لْكَ[n[ـٰ]فِرِينَ أَمْهِلْهُمْ رُوَيْدَۢا"}]}