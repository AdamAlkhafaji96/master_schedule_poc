{"number": 91, "name": "سُورَةُ الشَّمۡسِ", "englishName": "Ash-Shams", "englishNameTranslation": "The Sun", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا", "taj": "وَ[h:9999[ٱ][l[ل]شَّمْسِ وَضُحَ[n[ـٰ]هَا"}, {"n": 2, "text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا", "taj": "وَ[h:9999[ٱ]لْقَمَرِ إِذَا تَلَ[n[ـٰ]هَا"}, {"n": 3, "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا", "taj": "وَ[h:9999[ٱ][l[ل][g[نّ]َهَارِ إِذَا جَلَّ[n[ـٰ]هَا"}, {"n": 4, "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا", "taj": "وَ[h:9999[ٱ]لَّيْلِ إِذَا يَغْشَ[n[ـٰ]هَا"}, {"n": 5, "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا", "taj": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ وَمَا بَنَ[n[ـٰ]هَا"}, {"n": 6, "text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا", "taj": "وَ[h:9999[ٱ]لْأَرْضِ وَمَا طَحَ[n[ـٰ]هَا"}, {"n": 7, "text": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا", "taj": "وَنَفْ[a:14521[سٍ و]َمَا سَوَّ[n[ٮٰ]هَا"}, {"n": 8, "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا", "taj": "فَأَلْهَمَهَا فُجُورَهَا وَتَ[q:14522[قْ]وَ[n[ٮٰ]هَا"}, {"n": 9, "text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا", "taj": "قَ[q:298[دْ] أَفْلَحَ مَ[f:14523[ن ز]َكَّ[n[ـٰ]هَا"}, {"n": 10, "text": "وَقَدْ خَابَ مَن دَسَّىٰهَا", "taj": "وَقَ[q:387[دْ] خَابَ مَ[f:14524[ن د]َسَّ[n[ـٰ]هَا"}, {"n": 11, "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ", "taj": "كَذَّبَتْ ثَمُودُ بِطَغْوَ[n[ٮٰ]هَآ"}, {"n": 12, "text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا", "taj": "إِذِ [h:14525[ٱ][i:14526[نۢب]َعَثَ أَشْقَ[n[ـٰ]هَا"}, {"n": 13, "text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا", "taj": "فَقَالَ لَهُمْ رَسُولُ [h:3306[ٱ]للَّهِ نَاقَةَ [h:14527[ٱ]للَّهِ وَسُ[q:14528[قْ]يَ[n[ـٰ]هَا"}, {"n": 14, "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا", "taj": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّه[c:14529[ُم ب]ِذَ[i:13779[نۢب]ِهِمْ فَسَوَّ[n[ٮٰ]هَا"}, {"n": 15, "text": "وَلَا يَخَافُ عُقْبَٰهَا", "taj": "وَلَا يَخَافُ عُ[q:14530[قْ]بَ[n[ـٰ]هَا"}]}