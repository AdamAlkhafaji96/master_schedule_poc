{"number": 56, "name": "سُورَةُ الوَاقِعَةِ", "englishName": "Al-Waaqia", "englishNameTranslation": "The Inevitable", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ", "taj": "إِذَا وَقَعَتِ [h:13200[ٱ]لْوَاقِعَةُ"}, {"n": 2, "text": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ", "taj": "لَيْسَ لِوَ[q:13201[قْ]عَتِهَا كَاذِبَةٌ"}, {"n": 3, "text": "خَافِضَةٌۭ رَّافِعَةٌ", "taj": "خَافِضَ[u:13202[ةٌ ر]َّافِعَةٌ"}, {"n": 4, "text": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا", "taj": "إِذَا رُجَّتِ [h:13203[ٱ]لْأَرْضُ رَجًّا"}, {"n": 5, "text": "وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا", "taj": "وَبُسَّتِ [h:13204[ٱ]لْجِبَالُ بَسًّا"}, {"n": 6, "text": "فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا", "taj": "فَكَانَتْ هَب[o[َا]ٓ[a:13205[ءً م]ُّ[i:13206[نۢب]َثًّا"}, {"n": 7, "text": "وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ", "taj": "وَكُ[f:151[نت]ُمْ أَزْو[n[َٲ][f:13207[جًا ث]َلَ[n[ـٰ]ثَةً"}, {"n": 8, "text": "فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ", "taj": "فَأَصْحَ[n[ـٰ]بُ [h:13208[ٱ]لْمَيْمَنَةِ م[o[َآ] أَصْحَ[n[ـٰ]بُ [h:13209[ٱ]لْمَيْمَنَةِ"}, {"n": 9, "text": "وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ", "taj": "وَأَصْحَ[n[ـٰ]بُ [h:13210[ٱ]لْمَشْــَٔمَةِ م[o[َآ] أَصْحَ[n[ـٰ]بُ [h:13211[ٱ]لْمَشْــَٔمَةِ"}, {"n": 10, "text": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ", "taj": "وَ[h:9999[ٱ][l[ل]سَّ[n[ـٰ]بِقُونَ [h:13212[ٱ][l[ل]سَّ[n[ـٰ]بِق[p[ُو]نَ"}, {"n": 11, "text": "أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ", "taj": "أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ [h:13213[ٱ]لْمُقَرَّب[p[ُو]نَ"}, {"n": 12, "text": "فِى جَنَّٰتِ ٱلنَّعِيمِ", "taj": "فِى جَ[g[نّ]َ[n[ـٰ]تِ [h:3680[ٱ][l[ل][g[نّ]َع[p[ِي]مِ"}, {"n": 13, "text": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ", "taj": "ثُلَّ[a:13214[ةٌ م]ِّنَ [h:11455[ٱ]لْأَوَّل[p[ِي]نَ"}, {"n": 14, "text": "وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ", "taj": "وَقَلِي[a:13215[لٌ م]ِّنَ [h:13216[ٱ]لْأَخِر[p[ِي]نَ"}, {"n": 15, "text": "عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ", "taj": "عَلَىٰ سُرُ[a:13217[رٍ م]َّوْضُونَةٍ"}, {"n": 16, "text": "مُّتَّكِـِٔينَ عَلَي