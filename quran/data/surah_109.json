{"number": 109, "name": "سُورَةُ الكَافِرُونَ", "englishName": "Al-Kaafiroon", "englishNameTranslation": "The Disbelievers", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ", "taj": "قُلْ يَ[o[ـٰٓ]أَيُّهَا [h:14663[ٱ]لْكَ[n[ـٰ]فِر[p[ُو]نَ"}, {"n": 2, "text": "لَآ أَعْبُدُ مَا تَعْبُدُونَ", "taj": "ل[o[َآ] أَعْبُدُ مَا تَعْبُد[p[ُو]نَ"}, {"n": 3, "text": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ", "taj": "وَل[o[َآ] أَ[f:428[نت]ُمْ عَ[n[ـٰ]بِدُونَ م[o[َآ] أَعْبُ[q[د]ُ"}, {"n": 4, "text": "وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ", "taj": "وَل[o[َآ] أَنَا۟ عَابِ[a:14664[دٌ م]َّا عَبَ[d:14665[د]تُّمْ"}, {"n": 5, "text": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ", "taj": "وَل[o[َآ] أَ[f:428[نت]ُمْ عَ[n[ـٰ]بِدُونَ م[o[َآ] أَعْبُ[q[د]ُ"}, {"n": 6, "text": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ", "taj": "لَكُمْ دِينُكُمْ وَلِىَ د[p[ِي]نِ"}]}