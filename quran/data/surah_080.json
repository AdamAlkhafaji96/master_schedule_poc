{"number": 80, "name": "سُورَةُ عَبَسَ", "englishName": "Abasa", "englishNameTranslation": "He frowned", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ", "taj": "عَبَسَ وَتَوَلَّىٰٓ"}, {"n": 2, "text": "أَن جَآءَهُ ٱلْأَعْمَىٰ", "taj": "أَ[f:14298[ن ج][o[َا]ٓءَهُ [h:14299[ٱ]لْأَعْمَىٰ"}, {"n": 3, "text": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ", "taj": "وَمَا يُ[q:10898[دْ]رِيكَ لَعَلَّهُ[n[ۥ] يَزَّكَّىٰٓ"}, {"n": 4, "text": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ", "taj": "أَوْ يَذَّكَّرُ فَتَ[f:14300[نف]َعَهُ [h:14301[ٱ][l[ل]ذِّكْرَىٰٓ"}, {"n": 5, "text": "أَمَّا مَنِ ٱسْتَغْنَىٰ", "taj": "أَ[g[مّ]َا مَنِ [h:14302[ٱ]سْتَغْنَىٰ"}, {"n": 6, "text": "فَأَنتَ لَهُۥ تَصَدَّىٰ", "taj": "فَأَ[f:14303[نت]َ لَهُ[n[ۥ] تَصَدَّىٰ"}, {"n": 7, "text": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ", "taj": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"}, {"n": 8, "text": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ", "taj": "وَأَ[g[مّ]َا مَ[f:14304[ن ج][o[َا]ٓءَكَ يَسْعَىٰ"}, {"n": 9, "text": "وَهُوَ يَخْشَىٰ", "taj": "وَهُوَ يَخْشَىٰ"}, {"n": 10, "text": "فَأَنتَ عَنْهُ تَلَهَّىٰ", "taj": "فَأَ[f:14303[نت]َ عَنْهُ تَلَهَّىٰ"}, {"n": 11, "text": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ", "taj": "كَلّ[o[َآ] إِ[g[نّ]َهَا تَذْكِرَةٌ"}, {"n": 12, "text": "فَمَن شَآءَ ذَكَرَهُۥ", "taj": "فَمَ[f:8041[ن ش][o[َا]ٓءَ ذَكَرَهُۥ"}, {"n": 13, "text": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ", "taj": "فِى صُحُ[a:14305[فٍ م]ُّكَرَّمَةٍ"}, {"n": 14, "text": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ", "taj": "مَّرْفُوعَ[a:14306[ةٍ م]ُّطَهَّرَةِۭ"}, {"n": 15, "text": "بِأَيْدِى سَفَرَةٍۢ", "taj": "بِأَيْدِى سَفَرَةٍ"}, {"n": 16, "text": "كِرَامٍۭ بَرَرَةٍۢ", "taj": "كِرَا[i:14307[مِۭ ب]َرَرَةٍ"}, {"n": 17, "text": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ", "taj": "قُتِلَ [h:14308[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ م[o[َآ] أَكْفَرَهُۥ"}, {"n": 18, "text": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ", "taj": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"}, {"n": 19, "text": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ", "taj": "م[a:7325[ِن ن]ُّ[q:7326[طْ]فَةٍ خَلَقَهُ[n[ۥ] فَقَدَّرَهُۥ"}, {"n": 20, "text": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ", "taj": "ثُ[g[مّ]َ [h:14309[ٱ][l[ل]سَّبِيلَ يَسَّرَهُۥ"}, {"n": 21, "text": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ", "taj": "ثُ[g[مّ]َ أَمَاتَهُ[n[ۥ] فَأَ[q:14310[قْ]بَرَهُۥ"}, {"n": 22, "text": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ", "taj": "ثُ[g[مّ]َ إِذَا ش[o[َا]ٓءَ أَ[f:14311[نش]َرَهُۥ"}, {"n": 23, "text": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ", "taj": "كَلَّا لَ[g[مّ]َا يَ[q:14312[قْ]ضِ م[o[َآ] أَمَرَهُۥ"}, {"n": 24, "text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ", "taj": "فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ إِلَىٰ طَعَامِهِۦٓ"}, {"n": 25, "text": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا", "taj": "أَ[g[نّ]َا صَبَ[q:14315[بْ]نَا [h:14316[ٱ]لْم[o[َا]ٓءَ صَبًّا"}, {"n": 26, "text": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا", "taj": "ثُ[g[مّ]َ شَقَ[q:14317[قْ]نَا [h:14318[ٱ]لْأَرْضَ شَقًّا"}, {"n": 27, "text": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا", "taj": "فَأَ[i:9998[نۢب]َتْنَا فِيهَا حَبًّا"}, {"n": 28, "text": "وَعِنَبًۭا وَقَضْبًۭا", "taj": "وَعِنَ[a:14319[بًا و]َقَضْبًا"}, {"n": 29, "text": "وَزَيْتُونًۭا وَنَخْلًۭا", "taj": "وَزَيْتُو[a:14320[نًا و]َنَخْلاً"}, {"n": 30, "text": "وَحَدَآئِقَ غُلْبًۭا", "taj": "وَحَد[o[َا]ٓئِقَ غُلْبًا"}, {"n": 31, "text": "وَفَٰكِهَةًۭ وَأَبًّۭا", "taj": "وَفَ[n[ـٰ]كِهَ[a:14321[ةً و]َأَبًّا"}, {"n": 32, "text": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "taj": "مَّتَ[n[ـٰ][u:3808[عًا ل]َّكُمْ وَلِأَنْعَ[n[ـٰ]مِكُمْ"}, {"n": 33, "text": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ", "taj": "فَإِذَا ج[o[َا]ٓءَتِ [h:14322[ٱ][l[ل]صّ[m[َا]ٓخَّةُ"}, {"n": 34, "text": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ", "taj": "يَوْمَ يَفِرُّ [h:14323[ٱ]لْمَرْءُ مِنْ أَخ[p[ِي]هِ"}, {"n": 35, "text": "وَأُمِّهِۦ وَأَبِيهِ", "taj": "وَأُ[g[مّ]ِه[n[ِۦ] وَأَب[p[ِي]هِ"}, {"n": 36, "text": "وَصَٰحِبَتِهِۦ وَبَنِيهِ", "taj": "وَصَ[n[ـٰ]حِبَتِه[n[ِۦ] وَبَن[p[ِي]هِ"}, {"n": 37, "text": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ", "taj": "لِكُلِّ [h:9345[ٱ]مْرِى[a:9346[ٍٕ م]ِّنْهُمْ يَوْمَئِ[f:14324[ذٍ ش]َأْ[a:14325[نٌ ي]ُغْن[p[ِي]هِ"}, {"n": 38, "text": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ", "taj": "وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14326[ذٍ م]ُّسْفِرَةٌ"}, {"n": 39, "text": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ", "taj": "ضَاحِكَ[a:14327[ةٌ م]ُّسْتَ[q:14328[بْ]شِرَةٌ"}, {"n": 40, "text": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ", "taj": "وَوُجُو[a:14137[هٌ ي]َوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"}, {"n": 41, "text": "تَرْهَقُهَا قَتَرَةٌ", "taj": "تَرْهَقُهَا قَتَرَةٌ"}, {"n": 42, "text": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ", "taj": "أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ هُمُ [h:14329[ٱ]لْكَفَرَةُ [h:14330[ٱ]لْفَجَرَةُ"}]}