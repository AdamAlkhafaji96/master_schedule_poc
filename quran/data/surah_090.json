{"number": 90, "name": "سُورَةُ البَلَدِ", "englishName": "Al-Balad", "englishNameTranslation": "The City", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ", "taj": "ل[o[َآ] أُ[q:13287[قْ]سِمُ بِهَ[n[ـٰ]ذَا [h:14500[ٱ]لْبَلَ[q[د]ِ"}, {"n": 2, "text": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ", "taj": "وَأَ[f:3893[نت]َ حِل[i:14501[ُّۢ ب]ِهَ[n[ـٰ]ذَا [h:14500[ٱ]لْبَلَ[q[د]ِ"}, {"n": 3, "text": "وَوَالِدٍۢ وَمَا وَلَدَ", "taj": "وَوَالِ[a:14502[دٍ و]َمَا وَلَ[q[د]َ"}, {"n": 4, "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ", "taj": "لَقَ[q:2389[دْ] خَلَ[q:5159[قْ]نَا [h:7228[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ فِى كَبَ[q[د]ٍ"}, {"n": 5, "text": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ", "taj": "أَيَحْسَبُ أ[u:8842[َن ل]ّ[a:14503[َن ي]َ[q:14504[قْ]دِرَ عَلَيْهِ أَحَ[q[د]ٌ"}, {"n": 6, "text": "يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا", "taj": "يَقُولُ أَهْلَكْتُ مَال[u:14505[اً ل]ُّبَدًا"}, {"n": 7, "text": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ", "taj": "أَيَحْسَبُ أ[u:4423[َن ل]َّمْ يَرَهُ[o[ۥٓ] أَحَ[q[د]ٌ"}, {"n": 8, "text": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ", "taj": "أَلَمْ نَ[q:8219[جْ]عَل لَّهُ[n[ۥ] عَيْنَ[p[يْ]نِ"}, {"n": 9, "text": "وَلِسَانًۭا وَشَفَتَيْنِ", "taj": "وَلِسَا[a:14506[نًا و]َشَفَتَ[p[يْ]نِ"}, {"n": 10, "text": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ", "taj": "وَهَدَيْنَ[n[ـٰ]هُ [h:14507[ٱ][l[ل][g[نّ]َ[q:14508[جْ]دَ[p[يْ]نِ"}, {"n": 11, "text": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ", "taj": "فَلَا [h:14509[ٱ][q:14510[قْ]تَحَمَ [h:14511[ٱ]لْعَقَبَةَ"}, {"n": 12, "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ", "taj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14512[ٱ]لْعَقَبَةُ"}, {"n": 13, "text": "فَكُّ رَقَبَةٍ", "taj": "فَكُّ رَقَبَةٍ"}, {"n": 14, "text": "أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ", "taj": "أَوْ إِ[q:14513[طْ]عَ[n[ـٰ][f:14514[مٌ ف]ِى يَوْ[f:14515[مٍ ذ]ِى مَسْغَبَةٍ"}, {"n": 15, "text": "يَتِيمًۭا ذَا مَقْرَبَةٍ", "taj": "يَتِي[f:14516[مًا ذ]َا مَ[q:14517[قْ]رَبَةٍ"}, {"n": 16, "text": "أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ", "taj": "أَوْ مِسْكِي[f:14518[نًا ذ]َا مَتْرَبَةٍ"}, {"n": 17, "text": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ", "taj": "ثُ[g[مّ]َ كَانَ مِنَ [h:523[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَتَوَاصَوْ[s[اْ] بِ[h:223[ٱ][l[ل]صَّ[q:223[بْ]رِ وَتَوَاصَوْ[s[اْ] بِ[h:14519[ٱ]لْمَرْحَمَةِ"}, {"n": 18, "text": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ", "taj": "أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ أَصْحَ[n[ـٰ]بُ [h:13209[ٱ]لْمَيْمَنَةِ"}, {"n": 19, "text": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ", "taj": "وَ[h:9999[ٱ]لَّذِينَ كَفَرُو[s[اْ] بِـَٔـايَ[n[ـٰ]تِنَا هُمْ أَصْحَ[n[ـٰ]بُ [h:13211[ٱ]لْمَشْــَٔمَةِ"}, {"n": 20, "text": "عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ", "taj": "عَلَيْهِمْ نَا[a:14520[رٌ م]ُّؤْصَدَةُۢ"}]}