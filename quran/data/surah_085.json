{"number": 85, "name": "سُورَةُ البُرُوجِ", "englishName": "Al-Burooj", "englishNameTranslation": "The Constellations", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ", "taj": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ ذَاتِ [h:14402[ٱ]لْبُر[p[ُو][q[ج]ِ"}, {"n": 2, "text": "وَٱلْيَوْمِ ٱلْمَوْعُودِ", "taj": "وَ[h:9999[ٱ]لْيَوْمِ [h:14403[ٱ]لْمَوْع[p[ُو][q[د]ِ"}, {"n": 3, "text": "وَشَاهِدٍۢ وَمَشْهُودٍۢ", "taj": "وَشَاهِ[a:14404[دٍ و]َمَشْه[p[ُو][q[د]ٍ"}, {"n": 4, "text": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ", "taj": "قُتِلَ أَصْحَ[n[ـٰ]بُ [h:14405[ٱ]لْأُخْد[p[ُو][q[د]ِ"}, {"n": 5, "text": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ", "taj": "ٱ[l[ل][g[نّ]َارِ ذَاتِ [h:14406[ٱ]لْوَق[p[ُو][q[د]ِ"}, {"n": 6, "text": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ", "taj": "إِذْ هُمْ عَلَيْهَا قُع[p[ُو][q[د]ٌ"}, {"n": 7, "text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ", "taj": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِ[h:3560[ٱ]لْمُؤْمِنِينَ شُه[p[ُو][q[د]ٌ"}, {"n": 8, "text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ", "taj": "وَمَا نَقَمُو[s[اْ] مِنْهُمْ إِلّ[o[َآ] أ[a:386[َن ي]ُؤْمِنُو[s[اْ] بِ[h:32[ٱ]للَّهِ [h:14407[ٱ]لْعَزِيزِ [h:7037[ٱ]لْحَم[p[ِي][q[د]ِ"}, {"n": 9, "text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ", "taj": "ٱلَّذِى لَهُ[n[ۥ] مُلْكُ [h:555[ٱ][l[ل]سَّمَ[n[ـٰ]و[n[َٲ]تِ وَ[h:177[ٱ]لْأَرْضِ‌ۚ وَ[h:72[ٱ]للَّهُ عَلَىٰ كُلِّ ش[f:3903[َىْءٍ ش]َه[p[ِي][q[د]ٌ"}, {"n": 10, "text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ", "taj": "إِ[g[نّ]َ [h:24[ٱ]لَّذِينَ فَتَنُو[s[اْ] [h:14408[ٱ]لْمُؤْمِنِينَ وَ[h:5718[ٱ]لْمُؤْمِنَ[n[ـٰ]تِ ثُ[g[مّ]َ لَمْ يَتُوبُو[s[اْ] فَلَهُمْ عَذَابُ جَهَ[g[نّ]َمَ وَلَهُمْ عَذَابُ [h:14409[ٱ]لْحَر[p[ِي][q[ق]ِ"}, {"n": 11, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ", "taj": "إِ[g[نّ]َ [h:24[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَعَمِلُو[s[اْ] [h:118[ٱ][l[ل]صَّ[n[ـٰ]لِحَ[n[ـٰ]تِ لَهُمْ جَ[g[نّ]َ[n[ـٰ][f:1786[تٌ ت]َ[q:120[جْ]رِى مِ[f:121[ن ت]َحْتِهَا [h:122[ٱ]لْأَنْهَ[n[ـٰ]رُ‌ۚ ذ[n[َٲ]لِكَ [h:3911[ٱ]لْفَوْزُ [h:14410[ٱ]لْكَب[p[ِي]رُ"}, {"n": 12, "text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ", "taj": "إِ[g[نّ]َ بَ[q:14411[طْ]شَ رَبِّكَ لَشَد[p[ِي][q[د]ٌ"}, {"n": 13, "text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ", "taj": "إِ[g[نّ]َهُ[n[ۥ] هُوَ يُ[q:10320[بْ]دِئُ وَيُع[p[ِي][q[د]ُ"}, {"n": 14, "text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ", "taj": "وَهُوَ [h:6227[ٱ]لْغَفُورُ [h:14412[ٱ]لْوَد[p[ُو][q[د]ُ"}, {"n": 15, "text": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ", "taj": "ذُو [h:11807[ٱ]لْعَرْشِ [h:14413[ٱ]لْمَج[p[ِي][q[د]ُ"}, {"n": 16, "text": "فَعَّالٌۭ لِّمَا يُرِيدُ", "taj": "فَعَّا[u:6506[لٌ ل]ِّمَا يُر[p[ِي][q[د]ُ"}, {"n": 17, "text": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ", "taj": "هَلْ أَتَ[n[ـٰ]كَ حَدِيثُ [h:14414[ٱ]لْجُن[p[ُو][q[د]ِ"}, {"n": 18, "text": "فِرْعَوْنَ وَثَمُودَ", "taj": "فِرْعَوْنَ وَثَم[p[ُو][q[د]َ"}, {"n": 19, "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ", "taj": "بَلِ [h:10932[ٱ]لَّذِينَ كَفَرُو[s[اْ] فِى تَكْذ[p[ِي][q[ب]ٍ"}, {"n": 20, "text": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ", "taj": "وَ[h:9999[ٱ]للَّهُ م[a:12394[ِن و]َر[o[َا]ٓئِه[w:14415[ِم م]ُّح[p[ِي][q[ط]ُۢ"}, {"n": 21, "text": "بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ", "taj": "بَلْ هُوَ قُرْءَا[a:14416[نٌ م]َّج[p[ِي][q[د]ٌ"}, {"n": 22, "text": "فِى لَوْحٍۢ مَّحْفُوظٍۭ", "taj": "فِى لَوْ[a:14417[حٍ م]َّحْف[p[ُو]ظِۭ"}]}