{"number": 69, "name": "سُورَةُ الحَاقَّةِ", "englishName": "Al-Haaqqa", "englishNameTranslation": "The Reality", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ", "taj": "ٱلْح[m[َا]ٓقَّةُ"}, {"n": 2, "text": "مَا ٱلْحَآقَّةُ", "taj": "مَا [h:13857[ٱ]لْح[m[َا]ٓقَّةُ"}, {"n": 3, "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ", "taj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:13857[ٱ]لْح[m[َا]ٓقَّةُ"}, {"n": 4, "text": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ", "taj": "كَذَّبَتْ ثَمُودُ وَعَا[i:13859[دُۢ ب]ِ[h:13860[ٱ]لْقَارِعَةِ"}, {"n": 5, "text": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ", "taj": "فَأَ[g[مّ]َا ثَمُودُ فَأُهْلِكُو[s[اْ] بِ[h:13861[ٱ][l[ل]طَّاغِيَةِ"}, {"n": 6, "text": "وَأَمَّا عَادٌۭ فَأُهْلِكُوا۟ بِرِيحٍۢ صَرْصَرٍ عَاتِيَةٍۢ", "taj": "وَأَ[g[مّ]َا عَا[f:13862[دٌ ف]َأُهْلِكُو[s[اْ] بِرِي[f:13863[حٍ ص]َرْصَرٍ عَاتِيَةٍ"}, {"n": 7, "text": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍۢ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًۭا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍۢ", "taj": "سَخَّرَهَا عَلَيْهِمْ سَ[q:158[بْ]عَ لَيَا[a:13864[لٍ و]َثَمَ[n[ـٰ]نِيَةَ أَيَّامٍ حُسُو[f:13865[مًا ف]َتَرَى [h:13866[ٱ]لْقَوْمَ فِيهَا صَرْعَىٰ كَأَ[g[نّ]َهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ"}, {"n": 8, "text": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍۢ", "taj": "فَهَلْ تَرَىٰ لَه[w:1812[ُم م]ّ[i:13867[ِنۢ ب]َاقِيَةٍ"}, {"n": 9, "text": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ", "taj": "وَج[o[َا]ٓءَ فِرْعَوْنُ وَمَ[f:13868[ن ق]َ[q:13869[بْ]لَهُ[n[ۥ] وَ[h:13870[ٱ]لْمُؤْتَفِكَ[n[ـٰ]تُ بِ[h:13871[ٱ]لْخَاطِئَةِ"}, {"n": 10, "text": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةًۭ رَّابِيَةً", "taj": "فَعَصَوْ[s[اْ] رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَ[u:13872[ةً ر]َّابِيَةً"}, {"n": 11, "text": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ", "taj": "إِ[g[نّ]َا لَ[g[مّ]َا طَغَا [h:13873[ٱ]لْم[o[َا]ٓءُ حَمَلْنَ[n[ـٰ]كُمْ فِى [h:13874[ٱ]لْجَارِيَةِ"}, {"n": 12, "text": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ وَٰعِيَةٌۭ", "taj": "لِنَ[q:13875[جْ]عَلَهَا لَكُمْ تَذْكِرَ[a:13876[ةً و]َتَعِيَه[o[َآ] أُذُ[a:13877[نٌ و][n[َٲ]عِيَةٌ"}, {"n": 13, "text": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌۭ وَٰحِدَةٌۭ", "taj": "فَإِذَا نُفِخَ فِى [h:4185[ٱ][l[ل]صُّورِ نَفْخَ[a:13878[ةٌ و][n[َٲ]حِدَةٌ"}, {"n": 14, "text": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةًۭ وَٰحِدَةًۭ", "taj": "وَحُمِلَتِ [h:13879[ٱ]لْأَرْضُ وَ[h:8957[ٱ]لْجِبَالُ فَدُكَّتَا دَكَّ[a:13880[ةً و][n[َٲ]حِدَةً"}, {"n": 15, "text": "فَيَوْمَئِذٍۢ وَقَعَتِ ٱلْوَاقِعَةُ", "taj": "فَيَوْمَئِ[a:13881[ذٍ و]َقَعَتِ [h:13200[ٱ]لْوَاقِعَةُ"}, {"n": 16, "text": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍۢ وَاهِيَةٌۭ", "taj": "وَ[h:9999[ٱ][f:13882[نش]َقَّتِ [h:13883[ٱ][l[ل]سَّم[o[َا]ٓءُ فَهِىَ يَوْمَئِ[a:13884[ذٍ و]َاهِيَةٌ"}, {"n": 17, "text": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍۢ ثَمَٰنِيَةٌۭ", "taj": "وَ[h:9999[ٱ]لْمَلَكُ عَلَ[o[ىٰٓ] أَرْج[o[َا]ٓئِهَا‌ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِ[f:13885[ذٍ ث]َمَ[n[ـٰ]نِيَةٌ"}, {"n": 18, "text": "يَوْمَئِذٍۢ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌۭ", "taj": "يَوْمَئِ[f:13886[ذٍ ت]ُعْرَضُونَ لَا تَخْفَىٰ مِ[f:344[نك]ُمْ خَافِيَةٌ"}, {"n": 19, "text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ", "taj": "فَأَ[g[مّ]َا مَنْ أُوتِىَ كِتَ[n[ـٰ]بَهُ[n[ۥ] بِيَمِينِه[n[ِۦ] فَيَقُولُ ه[o[َا]ٓؤُمُ [h:13887[ٱ][q:13888[قْ]رَءُو[s[اْ] كِتَ[n[ـٰ]بِيَهْ"}, {"n": 20, "text": "إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ", "taj": "إِ[g[نّ]ِى ظَنَ[f:13889[نت]ُ أَ[g[نّ]ِى مُلَ[n[ـٰ]قٍ حِسَابِيَهْ"}, {"n": 21, "text": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "taj": "فَهُوَ فِى عِيشَ[u:13890[ةٍ ر]َّاضِيَةٍ"}, {"n": 22, "text": "فِى جَنَّةٍ عَالِيَةٍۢ", "taj": "فِى جَ[g[نّ]َةٍ عَالِيَةٍ"}, {"n": 23, "text": "قُطُوفُهَا دَانِيَةٌۭ", "taj": "قُطُوفُهَا دَانِيَةٌ"}, {"n": 24, "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ", "taj": "كُلُو[s[اْ] وَ[h:300[ٱ]شْرَبُو[s[اْ] هَنِ[o[يٓـ]ـ[i:12907[ـَٔۢا ب]ِم[o[َآ] أَسْلَفْتُمْ فِى [h:13891[ٱ]لْأَيَّامِ [h:13892[ٱ]لْخَالِيَةِ"}, {"n": 25, "text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ", "taj": "وَأَ[g[مّ]َا مَنْ أُوتِىَ كِتَ[n[ـٰ]بَهُ[n[ۥ] بِشِمَالِه[n[ِۦ] فَيَقُولُ يَ[n[ـٰ]لَيْتَنِى لَمْ أُوتَ كِتَ[n[ـٰ]بِيَهْ"}, {"n": 26, "text": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ", "taj": "وَلَمْ أَ[q:13893[دْ]رِ مَا حِسَابِيَهْ"}, {"n": 27, "text": "يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ", "taj": "يَ[n[ـٰ]لَيْتَهَا كَانَتِ [h:13894[ٱ]لْقَاضِيَةَ"}, {"n": 28, "text": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ", "taj": "م[o[َآ] أَغْنَىٰ عَ[g[نّ]ِى مَالِيَهْۜ"}, {"n": 29, "text": "هَلَكَ عَنِّى سُلْطَٰنِيَهْ", "taj": "هَلَكَ عَ[g[نّ]ِى سُلْطَ[n[ـٰ]نِيَهْ"}, {"n": 30, "text": "خُذُوهُ فَغُلُّوهُ", "taj": "خُذُوهُ فَغُلّ[p[ُو]هُ"}, {"n": 31, "text": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ", "taj": "ثُ[g[مّ]َ [h:13895[ٱ]لْجَحِيمَ صَلّ[p[ُو]هُ"}, {"n": 32, "text": "ثُمَّ فِى سِلْسِلَةٍۢ ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا فَٱسْلُكُوهُ", "taj": "ثُ[g[مّ]َ فِى سِلْسِلَ[f:13896[ةٍ ذ]َرْعُهَا سَ[q:13897[بْ]عُونَ ذِرَا[f:13898[عًا ف]َ[h:13899[ٱ]سْلُك[p[ُو]هُ"}, {"n": 33, "text": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ", "taj": "إِ[g[نّ]َهُ[n[ۥ] كَانَ لَا يُؤْمِنُ بِ[h:32[ٱ]للَّهِ [h:13900[ٱ]لْعَظ[p[ِي]مِ"}, {"n": 34, "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "taj": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ [h:13901[ٱ]لْمِسْك[p[ِي]نِ"}, {"n": 35, "text": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌۭ", "taj": "فَلَيْسَ لَهُ [h:13902[ٱ]لْيَوْمَ هَ[n[ـٰ]هُنَا حَم[p[ِي]مٌ"}, {"n": 36, "text": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍۢ", "taj": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْل[p[ِي]نٍ"}, {"n": 37, "text": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ", "taj": "لَّا يَأْكُلُهُ[o[ۥٓ] إِلَّا [h:13903[ٱ]لْخَ[n[ـٰ]طِــٔ[p[ُو]نَ"}, {"n": 38, "text": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ", "taj": "فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِمَا تُ[q:8674[بْ]صِر[p[ُو]نَ"}, {"n": 39, "text": "وَمَا لَا تُبْصِرُونَ", "taj": "وَمَا لَا تُ[q:8674[بْ]صِر[p[ُو]نَ"}, {"n": 40, "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "taj": "إِ[g[نّ]َهُ[n[ۥ] لَقَوْلُ رَسُو[f:13904[لٍ ك]َر[p[ِي]مٍ"}, {"n": 41, "text": "وَمَا هُوَ بِقَوْلِ شَاعِرٍۢ ۚ قَلِيلًۭا مَّا تُؤْمِنُونَ", "taj": "وَمَا هُوَ بِقَوْلِ شَاعِ[f:13905[رٍ‌ۚ ق]َلِيل[a:4583[اً م]َّا تُؤْمِن[p[ُو]نَ"}, {"n": 42, "text": "وَلَا بِقَوْلِ كَاهِنٍۢ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ", "taj": "وَلَا بِقَوْلِ كَاهِ[f:13906[نٍ‌ۚ ق]َلِيل[a:4583[اً م]َّا تَذَكَّر[p[ُو]نَ"}, {"n": 43, "text": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ", "taj": "تَ[f:11949[نز]ِي[a:12045[لٌ م]ّ[u:4772[ِن ر]َّبِّ [h:4[ٱ]لْعَ[n[ـٰ]لَم[p[ِي]نَ"}, {"n": 44, "text": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ", "taj": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ [h:13907[ٱ]لْأَقَاو[p[ِي]لِ"}, {"n": 45, "text": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ", "taj": "لَأَخَذْنَا مِنْهُ بِ[h:11402[ٱ]لْيَم[p[ِي]نِ"}, {"n": 46, "text": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ", "taj": "ثُ[g[مّ]َ لَقَطَعْنَا مِنْهُ [h:13908[ٱ]لْوَت[p[ِي]نَ"}, {"n": 47, "text": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ", "taj": "فَمَا مِ[f:344[نك][w:431[ُم م]ِّنْ أَحَدٍ عَنْهُ حَ[n[ـٰ]جِز[p[ِي]نَ"}, {"n": 48, "text": "وَإِنَّهُۥ لَتَذْكِرَةٌۭ لِّلْمُتَّقِينَ", "taj": "وَإِ[g[نّ]َهُ[n[ۥ] لَتَذْكِرَ[u:13909[ةٌ ل]ِّلْمُتَّق[p[ِي]نَ"}, {"n": 49, "text": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ", "taj": "وَإِ[g[نّ]َا لَنَعْلَمُ أَ[g[نّ]َ مِ[f:344[نك][w:13910[ُم م]ُّكَذِّب[p[ِي]نَ"}, {"n": 50, "text": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ", "taj": "وَإِ[g[نّ]َهُ[n[ۥ] لَحَسْرَةٌ عَلَى [h:468[ٱ]لْكَ[n[ـٰ]فِر[p[ِي]نَ"}, {"n": 51, "text": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ", "taj": "وَإِ[g[نّ]َهُ[n[ۥ] لَحَقُّ [h:13911[ٱ]لْيَق[p[ِي]نِ"}, {"n": 52, "text": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ", "taj": "فَسَبِّحْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:13286[ٱ]لْعَظ[p[ِي]مِ"}]}