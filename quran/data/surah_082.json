{"number": 82, "name": "سُورَةُ الانفِطَارِ", "englishName": "Al-Infitaar", "englishNameTranslation": "The Cleaving", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ", "taj": "إِذَا [h:14351[ٱ][l[ل]سَّم[o[َا]ٓءُ [h:14352[ٱ][f:14353[نف]َطَرَتْ"}, {"n": 2, "text": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ", "taj": "وَإِذَا [h:14354[ٱ]لْكَوَاكِبُ [h:14355[ٱ][f:14356[نت]َثَرَتْ"}, {"n": 3, "text": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ", "taj": "وَإِذَا [h:14337[ٱ]لْبِحَارُ فُجِّرَتْ"}, {"n": 4, "text": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ", "taj": "وَإِذَا [h:14357[ٱ]لْقُبُورُ بُعْثِرَتْ"}, {"n": 5, "text": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ", "taj": "عَلِمَتْ نَفْ[a:10644[سٌ م]َّا قَدَّمَتْ وَأَخَّرَتْ"}, {"n": 6, "text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ", "taj": "يَ[o[ـٰٓ]أَيُّهَا [h:14358[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مَا غَرَّكَ بِرَبِّكَ [h:14359[ٱ]لْكَر[p[ِي]مِ"}, {"n": 7, "text": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ", "taj": "ٱلَّذِى خَلَقَكَ فَسَوَّ[n[ٮٰ]كَ فَعَدَلَكَ"}, {"n": 8, "text": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ", "taj": "ف[o[ِىٓ] أَىِّ صُورَ[a:14360[ةٍ م]َّا ش[o[َا]ٓءَ رَكَّبَكَ"}, {"n": 9, "text": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ", "taj": "كَلَّا بَلْ تُكَذِّبُونَ بِ[h:14361[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 10, "text": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ", "taj": "وَإِ[g[نّ]َ عَلَيْكُمْ لَحَ[n[ـٰ]فِظ[p[ِي]نَ"}, {"n": 11, "text": "كِرَامًۭا كَٰتِبِينَ", "taj": "كِرَا[f:14362[مًا ك]َ[n[ـٰ]تِب[p[ِي]نَ"}, {"n": 12, "text": "يَعْلَمُونَ مَا تَفْعَلُونَ", "taj": "يَعْلَمُونَ مَا تَفْعَل[p[ُو]نَ"}, {"n": 13, "text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ", "taj": "إِ[g[نّ]َ [h:14162[ٱ]لْأَ[q:14163[بْ]رَارَ لَفِى نَع[p[ِي]مٍ"}, {"n": 14, "text": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ", "taj": "وَإِ[g[نّ]َ [h:14363[ٱ]لْفُجَّارَ لَفِى جَح[p[ِي]مٍ"}, {"n": 15, "text": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ", "taj": "يَصْلَوْنَهَا يَوْمَ [h:9781[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 16, "text": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ", "taj": "وَمَا هُمْ عَنْهَا بِغ[o[َا]ٓئِب[p[ِي]نَ"}, {"n": 17, "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "taj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11335[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 18, "text": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "taj": "ثُ[g[مّ]َ م[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11335[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 19, "text": "يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ", "taj": "يَوْمَ لَا تَمْلِكُ نَفْ[u:14364[سٌ ل]ِّنَفْ[f:14365[سٍ ش]َيْـ[a:14366[ـًٔا‌ۖ و]َ[h:4748[ٱ]لْأَمْرُ يَوْمَئِ[u:9076[ذٍ ل]ِّلَّهِ"}]}