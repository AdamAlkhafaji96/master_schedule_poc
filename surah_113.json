{"number": 113, "name": "سُورَةُ الفَلَقِ", "englishName": "Al-Falaq", "englishNameTranslation": "The Dawn", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ", "taj": "قُلْ أَعُوذُ بِرَبِّ [h:14678[ٱ]لْفَلَ[q[ق]ِ"}, {"n": 2, "text": "مِن شَرِّ مَا خَلَقَ", "taj": "مِ[f:14679[ن ش]َرِّ مَا خَلَ[q[ق]َ"}, {"n": 3, "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ", "taj": "وَمِ[f:14680[ن ش]َرِّ غَاسِقٍ إِذَا وَقَ[q[ب]َ"}, {"n": 4, "text": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ", "taj": "وَمِ[f:14680[ن ش]َرِّ [h:14681[ٱ][l[ل][g[نّ]َفَّ[n[ـٰ]ثَ[n[ـٰ]تِ فِى [h:14682[ٱ]لْعُقَ[q[د]ِ"}, {"n": 5, "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", "taj": "وَمِ[f:14680[ن ش]َرِّ حَاسِدٍ إِذَا حَسَ[q[د]َ"}]}