{"number": 78, "name": "سُورَةُ النَّبَإِ", "englishName": "An-Naba", "englishNameTranslation": "The Announcement", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ", "taj": "عَ[g[مّ]َ يَتَس[o[َا]ٓءَل[p[ُو]نَ"}, {"n": 2, "text": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ", "taj": "عَنِ [h:14239[ٱ][l[ل][g[نّ]َبَإِ [h:14240[ٱ]لْعَظ[p[ِي]مِ"}, {"n": 3, "text": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ", "taj": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِف[p[ُو]نَ"}, {"n": 4, "text": "كَلَّا سَيَعْلَمُونَ", "taj": "كَلَّا سَيَعْلَم[p[ُو]نَ"}, {"n": 5, "text": "ثُمَّ كَلَّا سَيَعْلَمُونَ", "taj": "ثُ[g[مّ]َ كَلَّا سَيَعْلَم[p[ُو]نَ"}, {"n": 6, "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا", "taj": "أَلَمْ نَ[q:14221[جْ]عَلِ [h:14222[ٱ]لْأَرْضَ مِهَ[n[ـٰ]دًا"}, {"n": 7, "text": "وَٱلْجِبَالَ أَوْتَادًۭا", "taj": "وَ[h:9999[ٱ]لْجِبَالَ أَوْتَادًا"}, {"n": 8, "text": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا", "taj": "وَخَلَ[q:14241[قْ]نَ[n[ـٰ]كُمْ أَزْو[n[َٲ]جًا"}, {"n": 9, "text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا", "taj": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا"}, {"n": 10, "text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا", "taj": "وَجَعَلْنَا [h:7689[ٱ]لَّيْلَ لِبَاسًا"}, {"n": 11, "text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا", "taj": "وَجَعَلْنَا [h:14242[ٱ][l[ل][g[نّ]َهَارَ مَعَاشًا"}, {"n": 12, "text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا", "taj": "وَبَنَيْنَا فَوْقَكُمْ سَ[q:7306[بْ][f:14243[عًا ش]ِدَادًا"}, {"n": 13, "text": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا", "taj": "وَجَعَلْنَا سِرَا[a:14244[جًا و]َهَّاجًا"}, {"n": 14, "text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا", "taj": "وَأَ[f:271[نز]َلْنَا مِنَ [h:14245[ٱ]لْمُعْصِر[n[َٲ]تِ م[o[َا]ٓ[f:14246[ءً ث]َجَّاجًا"}, {"n": 15, "text": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا", "taj": "لِّنُخْرِجَ بِه[n[ِۦ] حَب[a:14247[ًّا و]َنَبَاتًا"}, {"n": 16, "text": "وَجَنَّٰتٍ أَلْفَافًا", "taj": "وَجَ[g[نّ]َ[n[ـٰ]تٍ أَلْفَافًا"}, {"n": 17, "text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا", "taj": "إِ[g[نّ]َ يَوْمَ [h:12368[ٱ]لْفَصْلِ كَانَ مِيقَ[n[ـٰ]تًا"}, {"n": 18, "text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا", "taj": "يَوْمَ يُ[f:4184[نف]َخُ فِى [h:4185[ٱ][l[ل]صُّورِ فَتَأْتُونَ أَفْوَاجًا"}, {"n": 19, "text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا", "taj": "وَفُتِحَتِ [h:14248[ٱ][l[ل]سَّم[o[َا]ٓءُ فَكَانَتْ أَ[q:12251[بْ]و[n[َٲ]بًا"}, {"n": 20, "text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا", "taj": "وَسُيِّرَتِ [h:14249[ٱ]لْجِبَالُ فَكَانَتْ سَرَابًا"}, {"n": 21, "text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا", "taj": "إِ[g[نّ]َ جَهَ[g[نّ]َمَ كَانَتْ مِرْصَادًا"}, {"n": 22, "text": "لِّلطَّٰغِينَ مَـَٔابًۭا", "taj": "لِّلطَّ[n[ـٰ]غِينَ مَـَٔـابًا"}, {"n": 23, "text": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا", "taj": "لَّ[n[ـٰ]بِثِينَ فِيه[o[َآ] أَحْقَابًا"}, {"n": 24, "text": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا", "taj": "لَّا يَذُوقُونَ فِيهَا بَرْ[a:14250[دًا و]َلَا شَرَابًا"}, {"n": 25, "text": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا", "taj": "إِلَّا حَمِي[a:14251[مًا و]َغَسَّاقًا"}, {"n": 26, "text": "جَزَآءًۭ وِفَاقًا", "taj": "جَز[o[َا]ٓ[a:14252[ءً و]ِفَاقًا"}, {"n": 27, "text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا", "taj": "إِ[g[نّ]َهُمْ كَانُو[s[اْ] لَا يَرْجُونَ حِسَابًا"}, {"n": 28, "text": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا", "taj": "وَكَذَّبُو[s[اْ] بِـَٔـايَ[n[ـٰ]تِنَا كِذَّابًا"}, {"n": 29, "text": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا", "taj": "وَكُلَّ شَىْءٍ أَحْصَيْنَ[n[ـٰ]هُ كِتَ[n[ـٰ]بًا"}, {"n": 30, "text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا", "taj": "فَذُوقُو[s[اْ] فَل[a:14253[َن ن]َّزِيدَكُمْ إِلَّا عَذَابًا"}, {"n": 31, "text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا", "taj": "إِ[g[نّ]َ لِلْمُتَّقِينَ مَفَازًا"}, {"n": 32, "text": "حَدَآئِقَ وَأَعْنَٰبًۭا", "taj": "حَد[o[َا]ٓئِقَ وَأَعْنَ[n[ـٰ]بًا"}, {"n": 33, "text": "وَكَوَاعِبَ أَتْرَابًۭا", "taj": "وَكَوَاعِبَ أَتْرَابًا"}, {"n": 34, "text": "وَكَأْسًۭا دِهَاقًۭا", "taj": "وَكَأْ[f:14254[سًا د]ِهَاقًا"}, {"n": 35, "text": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا", "taj": "لَّا يَسْمَعُونَ فِيهَا لَغْ[a:13226[وًا و]َلَا كِذّ[n[َٲ]بًا"}, {"n": 36, "text": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا", "taj": "جَز[o[َا]ٓ[a:14255[ءً م]ّ[u:770[ِن ر]َّبِّكَ عَط[o[َا]ٓءً حِسَابًا"}, {"n": 37, "text": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا", "taj": "رَّبِّ [h:12320[ٱ][l[ل]سَّمَ[n[ـٰ]و[n[َٲ]تِ وَ[h:177[ٱ]لْأَرْضِ وَمَا بَيْنَهُمَا [h:14256[ٱ][l[ل]رَّحْمَ[n[ـٰ]نِ‌ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا"}, {"n": 38, "text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا", "taj": "يَوْمَ يَقُومُ [h:14257[ٱ][l[ل]رُّوحُ وَ[h:1146[ٱ]لْمَلَ[o[ـٰٓ]ئِكَةُ صَف[u:14258[ًّا‌ۖ ل]َّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ [h:8399[ٱ][l[ل]رَّحْمَ[n[ـٰ]نُ وَقَالَ صَوَابًا"}, {"n": 39, "text": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا", "taj": "ذ[n[َٲ]لِكَ [h:13944[ٱ]لْيَوْمُ [h:14259[ٱ]لْحَقُّ‌ۖ فَمَ[f:8041[ن ش][o[َا]ٓءَ [h:14056[ٱ]تَّخَذَ إِلَىٰ رَبِّه[n[ِۦ] مَـَٔـابًا"}, {"n": 40, "text": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا", "taj": "إِ[g[نّ][o[َآ] أَ[f:14260[نذ]َرْنَ[n[ـٰ]كُمْ عَذَا[f:14261[بًا ق]َرِي[a:14262[بًا ي]َوْمَ يَ[f:2039[نظ]ُرُ [h:14263[ٱ]لْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ [h:14264[ٱ]لْكَافِرُ يَ[n[ـٰ]لَيْتَنِى كُ[f:2917[نت]ُ تُر[n[َٲ]بَۢا"}]}