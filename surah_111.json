{"number": 111, "name": "سُورَةُ المَسَدِ", "englishName": "Al-Masad", "englishNameTranslation": "The Palm Fibre", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ", "taj": "تَبَّتْ يَد[o[َآ] أَبِى لَهَ[a:14669[بٍ و]َتَ[q[ب]َّ"}, {"n": 2, "text": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ", "taj": "م[o[َآ] أَغْنَىٰ عَنْهُ مَالُهُ[n[ۥ] وَمَا كَسَ[q[ب]َ"}, {"n": 3, "text": "سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ", "taj": "سَيَصْلَىٰ نَا[f:14670[رًا ذ]َاتَ لَهَ[q[ب]ٍ"}, {"n": 4, "text": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ", "taj": "وَ[h:9999[ٱ]مْرَأَتُهُ[n[ۥ] حَ[g[مّ]َالَةَ [h:14671[ٱ]لْحَطَ[q[ب]ِ"}, {"n": 5, "text": "فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ", "taj": "فِى جِيدِهَا حَ[q:14672[بْ][a:14673[لٌ م]ّ[a:14674[ِن م]َّسَ[q[د]ِۭ"}]}