{"number": 107, "name": "سُورَةُ المَاعُونِ", "englishName": "Al-Maa'un", "englishNameTranslation": "Almsgiving", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ", "taj": "أَرَءَيْتَ [h:14568[ٱ]لَّذِى يُكَذِّبُ بِ[h:14361[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 2, "text": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ", "taj": "فَذ[n[َٲ]لِكَ [h:14654[ٱ]لَّذِى يَدُعُّ [h:14655[ٱ]لْيَت[p[ِي]مَ"}, {"n": 3, "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "taj": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ [h:13901[ٱ]لْمِسْك[p[ِي]نِ"}, {"n": 4, "text": "فَوَيْلٌۭ لِّلْمُصَلِّينَ", "taj": "فَوَيْ[u:14656[لٌ ل]ِّلْمُصَلّ[p[ِي]نَ"}, {"n": 5, "text": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "taj": "ٱلَّذِينَ هُمْ عَ[f:14657[ن ص]َلَاتِهِمْ سَاه[p[ُو]نَ"}, {"n": 6, "text": "ٱلَّذِينَ هُمْ يُرَآءُونَ", "taj": "ٱلَّذِينَ هُمْ يُر[o[َا]ٓء[p[ُو]نَ"}, {"n": 7, "text": "وَيَمْنَعُونَ ٱلْمَاعُونَ", "taj": "وَيَمْنَعُونَ [h:14658[ٱ]لْمَاع[p[ُو]نَ"}]}