{"number": 102, "name": "سُورَةُ التَّكَاثُرِ", "englishName": "At-Takaathur", "englishNameTranslation": "Competition", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ", "taj": "أَلْهَ[n[ـٰ]كُمُ [h:14627[ٱ][l[ل]تَّكَاثُرُ"}, {"n": 2, "text": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ", "taj": "حَتَّىٰ زُرْتُمُ [h:14628[ٱ]لْمَقَابِرَ"}, {"n": 3, "text": "كَلَّا سَوْفَ تَعْلَمُونَ", "taj": "كَلَّا سَوْفَ تَعْلَم[p[ُو]نَ"}, {"n": 4, "text": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ", "taj": "ثُ[g[مّ]َ كَلَّا سَوْفَ تَعْلَم[p[ُو]نَ"}, {"n": 5, "text": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ", "taj": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ [h:14629[ٱ]لْيَق[p[ِي]نِ"}, {"n": 6, "text": "لَتَرَوُنَّ ٱلْجَحِيمَ", "taj": "لَتَرَوُ[g[نّ]َ [h:14630[ٱ]لْجَح[p[ِي]مَ"}, {"n": 7, "text": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ", "taj": "ثُ[g[مّ]َ لَتَرَوُ[g[نّ]َهَا عَيْنَ [h:14631[ٱ]لْيَق[p[ِي]نِ"}, {"n": 8, "text": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ", "taj": "ثُ[g[مّ]َ لَتُسْــَٔلُ[g[نّ]َ يَوْمَئِذٍ عَنِ [h:14632[ٱ][l[ل][g[نّ]َع[p[ِي]مِ"}]}