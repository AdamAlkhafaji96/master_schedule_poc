{"number": 37, "name": "سُورَةُ الصَّافَّاتِ", "englishName": "As-Saaffaat", "englishNameTranslation": "Those drawn up in Ranks", "revelationType": "Meccan", "ayahs": [{"n": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلصَّٰٓفَّٰتِ صَفًّۭا", "taj": "وَ[h:9999[ٱ][l[ل]صَّ[m[ـٰٓ]فَّ[n[ـٰ]تِ صَفًّا"}, {"n": 2, "text": "فَٱلزَّٰجِرَٰتِ زَجْرًۭا", "taj": "فَ[h:9999[ٱ][l[ل]زّ[n[َٲ]جِر[n[َٲ]تِ زَ[q:11312[جْ]رًا"}, {"n": 3, "text": "فَٱلتَّٰلِيَٰتِ ذِكْرًا", "taj": "فَ[h:9999[ٱ][l[ل]تَّ[n[ـٰ]لِيَ[n[ـٰ]تِ ذِكْرًا"}, {"n": 4, "text": "إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌۭ", "taj": "إِ[g[نّ]َ إِلَ[n[ـٰ]هَكُمْ لَو[n[َٲ]حِ[q[د]ٌ"}, {"n": 5, "text": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ", "taj": "رَّبُّ [h:6926[ٱ][l[ل]سَّمَ[n[ـٰ]و[n[َٲ]تِ وَ[h:177[ٱ]لْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ [h:11313[ٱ]لْمَشَ[n[ـٰ]رِ[q[ق]ِ"}, {"n": 6, "text": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ", "taj": "إِ[g[نّ]َا زَيَّ[g[نّ]َا [h:11314[ٱ][l[ل]سَّم[o[َا]ٓءَ [h:11315[ٱ][l[ل]دُّنْيَا بِزِينَةٍ [h:11316[ٱ]لْكَوَاكِ[q[ب]ِ"}, {"n": 7, "text": "وَحِفْظًۭا مِّن كُلِّ شَيْطَٰنٍۢ مَّارِدٍۢ", "taj": "وَحِفْ[a:11317[ظًا م]ِّ[f:843[ن ك]ُلِّ شَيْطَ[n[ـٰ][a:11318[نٍ م]َّارِ[q[د]ٍ"}, {"n": 8, "text": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍۢ", "taj": "لَّا يَسَّ[g[مّ]َعُونَ إِلَى [h:1384[ٱ]لْمَلَإِ [h:11319[ٱ]لْأَعْلَىٰ وَيُ[q:11320[قْ]ذَفُونَ مِ[f:843[ن ك]ُلِّ جَانِ[q[ب]ٍ"}, {"n": 9, "text": "دُحُورًۭا ۖ وَلَهُمْ عَذَابٌۭ وَاصِبٌ", "taj": "دُحُو[a:11321[رًا‌ۖ و]َلَهُمْ عَذَا[a:11322[بٌ و]َاصِ[q[ب]ٌ"}, {"n": 10, "text": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌۭ ثَاقِبٌۭ", "taj": "إِلَّا مَنْ خَطِفَ [h:11323[ٱ]لْخَ[q:11324[طْ]فَةَ فَأَتْبَعَهُ[n[ۥ] شِهَا[f:11325[بٌ ث]َاقِ[q[ب]ٌ"}, {"n": 11, "text": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَٰهُم مِّن طِينٍۢ لَّازِبٍۭ", "taj": "فَ[h:9999[ٱ]سْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أ[w:3110[َم م]َّنْ خَلَ[q:5159[قْ]ن[o[َآ‌ۚ] إِ[g[نّ]َا خَلَ[q:11326[قْ]نَ[n[ـٰ]ه[w:11327[ُم م]ِّ[f:3917[ن ط]ِي[u:11328[نٍ ل]َّازِ[q[ب]ِۭ"}, {"n": 12, "text": "بَلْ عَجِبْتَ وَيَسْخَرُونَ", "taj": "بَلْ عَجِ[q:11329[بْ]تَ وَيَسْخَر[p[ُو]نَ"}, {"n": 13, "text": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ", "taj": "وَإِذَا ذُكِّرُو[s[اْ] لَا يَذْكُر[p[ُو]نَ"}, {"n": 14, "text": "وَإِذَا رَأَوْا۟ ءَايَةًۭ يَسْتَسْخِرُونَ", "taj": "وَإِذَا رَأَوْ[s[اْ] ءَايَ[a:11330[ةً ي]َسْتَسْخِر[p[ُو]نَ"}, {"n": 15, "text": "وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ مُّبِينٌ", "taj": "وَقَال[o[ُوٓ][s[اْ] إِنْ هَ[n[ـٰ]ذ[o[َآ] إِلَّا سِحْ[a:3879[رٌ م]ُّب[p[ِي]نٌ"}, {"n": 16, "text": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ", "taj": "أَءِذَا مِتْنَا وَكُ[g[نّ]َا تُرَا[a:9207[بًا و]َعِظَ[n[ـٰ]مًا أَءِ[g[نّ]َا لَمَ[q:7784[بْ]عُوث[p[ُو]نَ"}, {"n": 17, "text": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ", "taj": "أَوَءَاب[o[َا]ٓؤُنَا [h:11331[ٱ]لْأَوَّل[p[ُو]نَ"}, {"n": 18, "text": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ", "taj": "قُلْ نَعَمْ وَأَ[f:98[نت]ُمْ د[n[َٲ]خِر[p[ُو]نَ"}, {"n": 19, "text": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ فَإِذَا هُمْ يَنظُرُونَ", "taj": "فَإِ[g[نّ]َمَا هِىَ زَ[q:11332[جْ]رَ[a:11333[ةٌ و][n[َٲ]حِدَ[f:11334[ةٌ ف]َإِذَا هُمْ يَ[f:1141[نظ]ُر[p[ُو]نَ"}, {"n": 20, "text": "وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ", "taj": "وَقَالُو[s[اْ] يَ[n[ـٰ]وَيْلَنَا هَ[n[ـٰ]ذَا يَوْمُ [h:11335[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 21, "text": "هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ", "taj": "هَ[n[ـٰ]ذَا يَوْمُ [h:11336[ٱ]لْفَصْلِ [h:11337[ٱ]لَّذِى كُ[f:100[نت][c:6084[ُم ب]ِه[n[ِۦ] تُكَذِّب[p[ُو]نَ"}, {"n": 22, "text": "۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ", "taj": "۞ ٱحْشُرُو[s[اْ] [h:11338[ٱ]لَّذِينَ ظَلَمُو[s[اْ] وَأَزْو[n[َٲ]جَهُمْ وَمَا كَانُو[s[اْ] يَعْبُد[p[ُو]نَ"}, {"n": 23, "text": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ", "taj": "مِ[f:107[ن د]ُونِ [h:108[ٱ]للَّهِ فَ[h:11339[ٱ]هْدُوهُمْ إِلَىٰ صِر[n[َٲ]طِ [h:11340[ٱ]لْجَح[p[ِي]مِ"}, {"n": 24, "text": "وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ", "taj": "وَقِفُوهُمْ‌ۖ إِ[g[نّ]َه[w:11341[ُم م]َّسْــُٔول[p[ُو]نَ"}, {"n": 25, "text": "مَا لَكُمْ لَا تَنَاصَرُونَ", "taj": "مَا لَكُمْ لَا تَنَاصَر[p[ُو]نَ"}, {"n": 26, "text": "بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ", "taj": "بَلْ هُمُ [h:11342[ٱ]لْيَوْمَ مُسْتَسْلِم[p[ُو]نَ"}, {"n": 27, "text": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ", "taj": "وَأَ[q:11343[قْ]بَلَ بَعْضُهُمْ عَلَىٰ بَعْ[a:11344[ضٍ ي]َتَس[o[َا]ٓءَل[p[ُو]نَ"}, {"n": 28, "text": "قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ", "taj": "قَال[o[ُوٓ][s[اْ] إِ[g[نّ]َكُمْ كُ[f:100[نت]ُمْ تَأْتُونَنَا عَنِ [h:7424[ٱ]لْيَم[p[ِي]نِ"}, {"n": 29, "text": "قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ", "taj": "قَالُو[s[اْ] بَل لَّمْ تَكُونُو[s[اْ] مُؤْمِن[p[ِي]نَ"}, {"n": 30, "text": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًۭا طَٰغِينَ", "taj": "وَمَا كَانَ لَنَا عَلَيْك[w:548[ُم م]ِّ[f:4798[ن س]ُلْطَ[n[ـٰ][i:11345[نِۭ‌ۖ ب]َلْ كُ[f:100[نت]ُمْ قَوْ[f:11346[مًا ط]َ[n[ـٰ]غ[p[ِي]نَ"}, {"n": 31, "text": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ", "taj": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّن[o[َآ‌ۖ] إِ[g[نّ]َا لَذ[o[َا]ٓئِق[p[ُو]نَ"}, {"n": 32, "text": "فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ", "taj": "فَأَغْوَيْنَ[n[ـٰ]كُمْ إِ[g[نّ]َا كُ[g[نّ]َا غَ[n[ـٰ]و[p[ِي]نَ"}, {"n": 33, "text": "فَإِنَّهُمْ يَوْمَئِذٍۢ فِى ٱلْعَذَابِ مُشْتَرِكُونَ", "taj": "فَإِ[g[نّ]َهُمْ يَوْمَئِ[f:11347[ذٍ ف]ِى [h:10442[ٱ]لْعَذَابِ مُشْتَرِك[p[ُو]نَ"}, {"n": 34, "text": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ", "taj": "إِ[g[نّ]َا كَذ[n[َٲ]لِكَ نَفْعَلُ بِ[h:11348[ٱ]لْمُ[q:11348[جْ]رِم[p[ِي]نَ"}, {"n": 35, "text": "إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ", "taj": "إِ[g[نّ]َهُمْ كَان[o[ُوٓ][s[اْ] إِذَا قِيلَ لَهُمْ ل[o[َآ] إِلَ[n[ـٰ]هَ إِلَّا [h:1742[ٱ]للَّهُ يَسْتَكْبِر[p[ُو]نَ"}, {"n": 36, "text": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍۢ مَّجْنُونٍۭ", "taj": "وَيَقُولُ